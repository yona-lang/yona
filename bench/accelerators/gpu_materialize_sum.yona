import fromSeq, foldl from Std\IntArray in
import upload, mapAdd, materialize from Std\Gpu in
let build n acc = if n <= 0 then acc else build (n - 1) (n :: acc) in
let input = fromSeq (build 20000 []) in
let buffer = upload input in
let shifted = mapAdd 3 buffer in
let output = materialize shifted in
foldl (\acc x -> acc + x) 0 output
