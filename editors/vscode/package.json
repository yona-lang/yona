{
  "name": "yona",
  "displayName": "Yona",
  "description": "Yona language support: syntax highlighting and the yls language server.",
  "version": "0.1.4",
  "publisher": "yona-lang",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/yona-lang/yona.git"
  },
  "bugs": {
    "url": "https://github.com/yona-lang/yona/issues"
  },
  "homepage": "https://github.com/yona-lang/yona/tree/HEAD/editors/vscode",
  "keywords": [
    "yona",
    "language-server",
    "lsp"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:yona"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "yona",
        "aliases": [
          "Yona",
          "yona"
        ],
        "extensions": [
          ".yona",
          ".yonai"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "yona",
        "scopeName": "source.yona",
        "path": "./syntaxes/yona.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "yona.explain",
        "title": "Yona: Explain error code"
      }
    ],
    "configuration": {
      "title": "Yona",
      "properties": {
        "yona.languageServer.path": {
          "type": "string",
          "default": "",
          "description": "Path to the yls language server. Empty uses PATH, YONA_HOME, then the directory containing yonac."
        },
        "yona.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace communication between VS Code and yls (vscode-languageclient)."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "tsc --noEmit -p ./",
    "test": "node ./out/test/run.js",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package",
    "vsix": "vsce package",
    "publish:marketplace": "vsce publish",
    "publish:ovsx": "ovsx publish"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "ovsx": "^0.10.12",
    "typescript": "^5.8.3"
  }
}
