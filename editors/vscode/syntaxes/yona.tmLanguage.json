{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "yona",
  "displayName": "Yona",
  "aliases": ["Yona", "yonai"],
  "scopeName": "source.yona",
  "fileTypes": ["yona", "yonai"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#characters" },
    { "include": "#numbers" },
    { "include": "#symbols" },
    { "include": "#borrow" },
    { "include": "#parallel-comprehension" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#effect-labels" },
    { "include": "#module-path" },
    { "include": "#types" },
    { "include": "#lambda" },
    { "include": "#operators" },
    { "include": "#function-definition" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.yona",
          "match": "##.*$"
        },
        {
          "name": "comment.line.number-sign.yona",
          "match": "#.*$"
        },
        {
          "name": "comment.block.yona",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [{ "include": "#comments" }]
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.yona",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.yona",
          "match": "\\\\[\"\\\\nrt0]"
        },
        {
          "name": "meta.interpolation.yona",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.yona" } },
          "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.yona" } },
          "patterns": [{ "include": "$self" }]
        }
      ]
    },
    "characters": {
      "name": "string.quoted.single.yona",
      "match": "'(\\\\[nrt0'\\\\]|[^'\\\\])'"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.yona",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.yona",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "symbols": {
      "name": "constant.other.symbol.yona",
      "match": "(?<![A-Za-z0-9_]):[a-zA-Z_][a-zA-Z0-9_]*"
    },
    "borrow": {
      "name": "storage.modifier.borrow.yona",
      "match": "@borrow\\b"
    },
    "parallel-comprehension": {
      "name": "keyword.operator.parallel.yona",
      "match": "\\[\\|"
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.yona",
          "match": "\\b(case|of|if|then|else|try|catch|raise|perform|handle|resume|end)\\b"
        },
        {
          "name": "keyword.other.binding.yona",
          "match": "\\b(let|in|do|with|as)\\b"
        },
        {
          "name": "keyword.other.module.yona",
          "match": "\\b(module|import|export|from)\\b"
        },
        {
          "name": "keyword.other.declaration.yona",
          "match": "\\b(type|trait|instance|extern|async|native|io|effect|fun|lambda|record|deriving|for)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.yona",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.unit.yona",
          "match": "\\(\\)"
        }
      ]
    },
    "effect-labels": {
      "name": "entity.name.tag.effect.yona",
      "match": "!\\{[^}]*\\}"
    },
    "module-path": {
      "patterns": [
        {
          "match": "\\b([A-Z][A-Za-z0-9_]*(?:\\\\[A-Z][A-Za-z0-9_]*)+)(::)([a-z][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.namespace.yona" },
            "2": { "name": "punctuation.accessor.yona" },
            "3": { "name": "entity.name.function.yona" }
          }
        },
        {
          "name": "entity.name.namespace.yona",
          "match": "\\b[A-Z][A-Za-z0-9_]*(?:\\\\[A-Z][A-Za-z0-9_]*)+\\b"
        }
      ]
    },
    "types": {
      "name": "entity.name.type.yona",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
    },
    "lambda": {
      "patterns": [
        {
          "name": "storage.type.function.lambda.yona",
          "match": "\\\\(?=\\s*(\\(|[a-z_]|->))"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.yona",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.pipe.yona",
          "match": "\\|>|<\\|"
        },
        {
          "name": "keyword.operator.list.yona",
          "match": "::|\\+\\+|--|:>"
        },
        {
          "name": "keyword.operator.comparison.yona",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.yona",
          "match": "&&|\\|\\||!(?!\\{)"
        },
        {
          "name": "keyword.operator.arithmetic.yona",
          "match": "\\*\\*|\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.bitwise.yona",
          "match": "<<|>>>|>>|&|\\^|~"
        },
        {
          "name": "keyword.operator.assignment.yona",
          "match": "="
        },
        {
          "name": "keyword.operator.membership.yona",
          "match": "\\bin\\b"
        }
      ]
    },
    "function-definition": {
      "match": "^\\s*([a-z_][A-Za-z0-9_]*)\\s*(?=(\\([^)]*\\)\\s*->|[a-z_(\\[].*=|\\s*:\\s*[A-Z(]))",
      "captures": {
        "1": { "name": "entity.name.function.yona" }
      }
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.member.yona",
          "match": "(?<=\\.)[a-z_][A-Za-z0-9_]*"
        },
        {
          "name": "variable.other.yona",
          "match": "\\b[a-z_][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
