MODULE Std\Set
FN contains 2 Set(VAR(element)) VAR(element) -> BOOL
FN difference 2 Set(VAR(element)) Set(VAR(element)) -> Set(VAR(element))
FN elements 1 Set(VAR(element)) -> Seq(VAR(element))
FN forEach 2 FUNCTION(VAR(element),UNIT) Set(VAR(element)) -> UNIT
FN insert 2 Set(VAR(element)) VAR(element) -> Set(VAR(element))
FN intersection 2 Set(VAR(element)) Set(VAR(element)) -> Set(VAR(element))
FN iterator 1 Set(VAR(element)) -> ADT(Iterator,VAR(element))
FN size 1 Set(VAR(element)) -> INT
FN union 2 Set(VAR(element)) Set(VAR(element)) -> Set(VAR(element))
