GENFN_CTOR yona_Std_GPU__checkGpu Err Result 1 1 2 1 fieldname:_0 field:INT contract:N(e)
GENFN_CTOR yona_Std_GPU__checkGpu GpuDeviceLost GpuIssue 2 0 4 1
GENFN_CTOR yona_Std_GPU__checkGpu GpuOom GpuIssue 1 0 4 1
GENFN_CTOR yona_Std_GPU__checkGpu GpuOther GpuIssue 3 1 4 1 field:INT shape:INT contract:N(Int)
GENFN_CTOR yona_Std_GPU__checkGpu Ok Result 0 1 2 1 fieldname:_0 field:INT contract:N(a)
GENFN_BEGIN yona_Std_GPU__checkGpu checkGpu
checkGpu =
    case vulkanLastIssueKind of
        0 -> Ok 0
        1 -> Err GpuOom
        2 -> Err GpuDeviceLost
        code -> Err (GpuOther code)
    end
GENFN_END
GENFN_CTOR yona_Std_GPU__drainMapFloatGPU None Option 1 0 2 1
GENFN_CTOR yona_Std_GPU__drainMapFloatGPU Some Option 0 1 2 1 fieldname:_0 field:INT contract:N(a)
GENFN_BEGIN yona_Std_GPU__drainMapFloatGPU drainMapFloatGPU
drainMapFloatGPU op rx tx =
    import send, recv from Std\Channel in
    case recv rx of
        None -> 0
        Some chunk ->
            let mapped = mapFloatGPU op chunk in
            let _ = send tx mapped in
            1 + drainMapFloatGPU op rx tx
    end
GENFN_END
GENFN_CTOR yona_Std_GPU__encodeIntMapStages Add IntMapOp 0 1 3 1 field:INT shape:INT contract:N(Int)
GENFN_CTOR yona_Std_GPU__encodeIntMapStages Mul IntMapOp 1 1 3 1 field:INT shape:INT contract:N(Int)
GENFN_CTOR yona_Std_GPU__encodeIntMapStages Square IntMapOp 2 0 3 1
GENFN_BEGIN yona_Std_GPU__encodeIntMapStages encodeIntMapStages
encodeIntMapStages stages =
    import fromSeq from Std\IntArray in
    import foldr from Std\List in
    fromSeq (foldr (\op acc ->
        case op of
            Add d -> 0 :: (d :: acc)
            Mul f -> 1 :: (f :: acc)
            Square -> 2 :: (0 :: acc)
        end) [] stages)
GENFN_END
GENFN_BEGIN yona_Std_GPU__gpuFloatChannel gpuFloatChannel
gpuFloatChannel n =
    import channel from Std\Channel in
    channel n
GENFN_END
GENFN_CTOR yona_Std_GPU__gpuLastIssue Err Result 1 1 2 1 fieldname:_0 field:INT contract:N(e)
GENFN_CTOR yona_Std_GPU__gpuLastIssue GpuDeviceLost GpuIssue 2 0 4 1
GENFN_CTOR yona_Std_GPU__gpuLastIssue GpuOk GpuIssue 0 0 4 1
GENFN_CTOR yona_Std_GPU__gpuLastIssue GpuOom GpuIssue 1 0 4 1
GENFN_CTOR yona_Std_GPU__gpuLastIssue GpuOther GpuIssue 3 1 4 1 field:INT shape:INT contract:N(Int)
GENFN_CTOR yona_Std_GPU__gpuLastIssue Ok Result 0 1 2 1 fieldname:_0 field:INT contract:N(a)
GENFN_BEGIN yona_Std_GPU__gpuLastIssue gpuLastIssue
gpuLastIssue =
    case vulkanLastIssueKind of
        0 -> GpuOk
        1 -> GpuOom
        2 -> GpuDeviceLost
        code -> GpuOther code
    end
GENFN_END
GENFN_CTOR yona_Std_GPU__mapGPU Add IntMapOp 0 1 3 1 field:INT shape:INT contract:N(Int)
GENFN_CTOR yona_Std_GPU__mapGPU Buffer Buffer 0 1 1 1 field:ADT shape:ADT contract:N(IntArray)
GENFN_CTOR yona_Std_GPU__mapGPU Mul IntMapOp 1 1 3 1 field:INT shape:INT contract:N(Int)
GENFN_CTOR yona_Std_GPU__mapGPU Square IntMapOp 2 0 3 1
GENFN_BEGIN yona_Std_GPU__mapGPU mapGPU
mapGPU : IntMapOp -> Buffer -> Buffer
mapGPU op buffer =
    case op of
        Add d -> mapAdd d buffer
        Mul f -> mapMul f buffer
        Square -> mapSquare buffer
    end
GENFN_END
GENFN_CTOR yona_Std_GPU__raiseGpu GpuDeviceLost GpuIssue 2 0 4 1
GENFN_CTOR yona_Std_GPU__raiseGpu GpuOk GpuIssue 0 0 4 1
GENFN_CTOR yona_Std_GPU__raiseGpu GpuOom GpuIssue 1 0 4 1
GENFN_CTOR yona_Std_GPU__raiseGpu GpuOther GpuIssue 3 1 4 1 field:INT shape:INT contract:N(Int)
GENFN_BEGIN yona_Std_GPU__raiseGpu raiseGpu
raiseGpu issue =
    case issue of
        GpuOk -> ()
        GpuOom -> perform Gpu.oom ()
        GpuDeviceLost -> perform Gpu.deviceLost ()
        GpuOther code -> perform Gpu.fail code
    end
GENFN_END
GENFN_CTOR yona_Std_GPU__reduceGPU Buffer Buffer 0 1 1 1 field:ADT shape:ADT contract:N(IntArray)
GENFN_CTOR yona_Std_GPU__reduceGPU Sum IntReduceOp 0 0 1 0
GENFN_BEGIN yona_Std_GPU__reduceGPU reduceGPU
reduceGPU : IntReduceOp -> Buffer -> Int
reduceGPU op buffer =
    case op of
        Sum -> reduceSum buffer
    end
GENFN_END
GENFN_BEGIN yona_Std_GPU__withGpuFallback withGpuFallback
withGpuFallback action =
    let result = action () in
    let _ = raiseGpu gpuLastIssue in
    result
GENFN_END
GENFN_CTOR yona_Std_GPU__withGpuIssue GpuDeviceLost GpuIssue 2 0 4 1
GENFN_CTOR yona_Std_GPU__withGpuIssue GpuOom GpuIssue 1 0 4 1
GENFN_CTOR yona_Std_GPU__withGpuIssue GpuOther GpuIssue 3 1 4 1 field:INT shape:INT contract:N(Int)
GENFN_BEGIN yona_Std_GPU__withGpuIssue withGpuIssue
withGpuIssue on_ok on_issue =
    case vulkanLastIssueKind of
        0 -> on_ok ()
        1 -> on_issue GpuOom
        2 -> on_issue GpuDeviceLost
        code -> on_issue (GpuOther code)
    end
GENFN_END
