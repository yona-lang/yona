MODULE Std\Http
ADT Method 7 0
  CTOR Get 0 0
  CTOR Post 1 0
  CTOR Put 2 0
  CTOR Delete 3 0
  CTOR Patch 4 0
  CTOR Head 5 0
  CTOR Options 6 0
ADT Request 1 4
  CTOR Request 0 4 fields method:ADT(Method) path:STRING headers:INT body:STRING
ADT Response 1 3
  CTOR Response 0 3 fields status:INT rawHeaders:STRING body:STRING
FN formatRequest 2 STRING ADT(Request) -> STRING borrow 11 effects -
FN get 3 STRING INT STRING -> ADT(Response) effects -
FN notFound 0 -> ADT(Response) effects -
FN ok 1 STRING -> ADT(Response) effects -
FN parseResponse 1 STRING -> ADT(Response) effects -
FN post 4 STRING INT STRING STRING -> ADT(Response) effects -
FN request 4 ADT(Method) STRING INT STRING -> ADT(Request) effects -
FN response 2 INT STRING -> ADT(Response) effects -
FN send 3 STRING INT ADT(Request) -> ADT(Response) effects -
FN serve 3 STRING INT FUNCTION(ADT(Request),ADT(Response)) -> INT effects |
FN serverError 0 -> ADT(Response) effects -
GENFN_CTOR formatRequest Request Request 0 4 1 4 fields method:ADT(Method) path:STRING headers:INT body:STRING
GENFN_CTOR formatRequest Response Response 0 3 1 3 fields status:INT rawHeaders:STRING body:STRING
GENFN_BEGIN formatRequest formatRequest
formatRequest : String -> Request -> String
formatRequest host req =
    import length from Std\String in
    import intToString from Std\Types in
    let method = methodString req.method,
        p = req.path,
        b = req.body,
        bodyLen = length b in
    if bodyLen > 0 then
        method ++ " " ++ p ++ " HTTP/1.1\r\nHost: " ++ host ++ "\r\nUser-Agent: Yona\r\nConnection: close\r\nContent-Length: " ++ (intToString bodyLen) ++ "\r\n\r\n" ++ b
    else
        method ++ " " ++ p ++ " HTTP/1.1\r\nHost: " ++ host ++ "\r\nUser-Agent: Yona\r\nConnection: close\r\n\r\n"
GENFN_END
GENFN_CTOR get Get Method 0 0 7 0
GENFN_CTOR get Request Request 0 4 1 4 fields method:ADT(Method) path:STRING headers:INT body:STRING
GENFN_CTOR get Response Response 0 3 1 3 fields status:INT rawHeaders:STRING body:STRING
GENFN_CTOR get Post Method 1 0 7 0
GENFN_BEGIN get get
get : String -> Int -> String -> Response
get host port path = send host port (Request { method = Get, path = path, headers = 0, body = "" })
GENFN_END
GENFN_CTOR notFound Response Response 0 3 1 3 fields status:INT rawHeaders:STRING body:STRING
GENFN_BEGIN notFound notFound
notFound = Response { status = 404, rawHeaders = "", body = "Not Found" }
GENFN_END
GENFN_CTOR ok Response Response 0 3 1 3 fields status:INT rawHeaders:STRING body:STRING
GENFN_BEGIN ok ok
ok : String -> Response
ok body = Response { status = 200, rawHeaders = "", body = body }
GENFN_END
GENFN_CTOR parseResponse Get Method 0 0 7 0
GENFN_CTOR parseResponse Response Response 0 3 1 3 fields status:INT rawHeaders:STRING body:STRING
GENFN_BEGIN parseResponse parseResponse
parseResponse : String -> Response
parseResponse raw =
    import substring, indexOf, drop from Std\String in
    import toInt from Std\String in
    let status = toInt (substring raw 9 3),
        bodyStart = indexOf "\r\n\r\n" raw in
    if bodyStart >= 0 then
        Response { status = status, rawHeaders = substring raw 0 bodyStart, body = drop (bodyStart + 4) raw }
    else
        Response { status = status, rawHeaders = "", body = "" }
GENFN_END
GENFN_CTOR post Request Request 0 4 1 4 fields method:ADT(Method) path:STRING headers:INT body:STRING
GENFN_CTOR post Response Response 0 3 1 3 fields status:INT rawHeaders:STRING body:STRING
GENFN_CTOR post Post Method 1 0 7 0
GENFN_BEGIN post post
post : String -> Int -> String -> String -> Response
post host port path body = send host port (Request { method = Post, path = path, headers = 0, body = body })
GENFN_END
GENFN_CTOR request Request Request 0 4 1 4 fields method:ADT(Method) path:STRING headers:INT body:STRING
GENFN_BEGIN request request
request : Method -> String -> Int -> String -> Request
request method path headers body = Request { method = method, path = path, headers = headers, body = body }
GENFN_END
GENFN_CTOR response Request Request 0 4 1 4 fields method:ADT(Method) path:STRING headers:INT body:STRING
GENFN_CTOR response Response Response 0 3 1 3 fields status:INT rawHeaders:STRING body:STRING
GENFN_BEGIN response response
response : Int -> String -> Response
response status body = Response { status = status, rawHeaders = "", body = body }
GENFN_END
GENFN_CTOR send Get Method 0 0 7 0
GENFN_CTOR send Linear Linear 0 1 1 1 fields _0:VAR(a)
GENFN_CTOR send Request Request 0 4 1 4 fields method:ADT(Method) path:STRING headers:INT body:STRING
GENFN_CTOR send Response Response 0 3 1 3 fields status:INT rawHeaders:STRING body:STRING
GENFN_BEGIN send send
send : String -> Int -> Request -> Response
send host port req =
    import tcpConnect, send as netSend, recv, close from Std\Net in
    case tcpConnect host port of
        Linear fd -> do
            netSend fd (formatRequest host req)
            raw = recv fd 65536
            close fd
            parseResponse raw
        end
    end
GENFN_END
GENFN_CTOR serve Linear Linear 0 1 1 1 fields _0:VAR(a)
GENFN_CTOR serve Request Request 0 4 1 4 fields method:ADT(Method) path:STRING headers:INT body:STRING
GENFN_CTOR serve Response Response 0 3 1 3 fields status:INT rawHeaders:STRING body:STRING
GENFN_BEGIN serve serve
serve : String -> Int -> (Request -> Response) -> Int
serve host port handler =
    import tcpListen from Std\Net in
    case tcpListen host port of
        Linear listener -> serveLoop listener handler
    end
GENFN_END
GENFN_CTOR serverError Response Response 0 3 1 3 fields status:INT rawHeaders:STRING body:STRING
GENFN_BEGIN serverError serverError
serverError = Response { status = 500, rawHeaders = "", body = "Internal Server Error" }
GENFN_END
