GENFN_CTOR yona_Std_Http__parseResponse GET Method 0 0 7 0
GENFN_CTOR yona_Std_Http__parseResponse Response Response 0 3 1 3 fieldname:status field:INT shape:INT contract:N(Int) fieldname:rawHeaders field:STRING shape:STRING contract:N(String) fieldname:body field:STRING shape:STRING contract:N(String)
GENFN_BEGIN yona_Std_Http__parseResponse parseResponse
parseResponse : String -> Response
parseResponse raw =
    import substring, indexOf, drop from Std\String in
    import toInt from Std\String in
    let status = toInt (substring raw 9 3),
        bodyStart = indexOf "\r\n\r\n" raw in
    if bodyStart >= 0 then
        Response { status = status, rawHeaders = substring raw 0 bodyStart, body = drop (bodyStart + 4) raw }
    else
        Response { status = status, rawHeaders = "", body = "" }
GENFN_END
