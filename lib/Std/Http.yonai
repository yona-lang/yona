GENFN_CTOR yona_Std_Http__formatRequest Request Request 0 4 1 4 fieldname:method field:ADT shape:ADT contract:N(Method) fieldname:path field:STRING shape:STRING contract:N(String) fieldname:headers field:INT shape:INT contract:N(Int) fieldname:body field:STRING shape:STRING contract:N(String)
GENFN_CTOR yona_Std_Http__formatRequest Response Response 0 3 1 3 fieldname:status field:INT shape:INT contract:N(Int) fieldname:rawHeaders field:STRING shape:STRING contract:N(String) fieldname:body field:STRING shape:STRING contract:N(String)
GENFN_BEGIN yona_Std_Http__formatRequest formatRequest
formatRequest : String -> Request -> String
formatRequest host req =
    import length from Std\String in
    import intToString from Std\Types in
    let method = methodString req.method,
        p = req.path,
        b = req.body,
        bodyLen = length b in
    if bodyLen > 0 then
        method ++ " " ++ p ++ " HTTP/1.1\r\nHost: " ++ host ++ "\r\nUser-Agent: Yona\r\nConnection: close\r\nContent-Length: " ++ (intToString bodyLen) ++ "\r\n\r\n" ++ b
    else
        method ++ " " ++ p ++ " HTTP/1.1\r\nHost: " ++ host ++ "\r\nUser-Agent: Yona\r\nConnection: close\r\n\r\n"
GENFN_END
