GENFN_CTOR yona_Std_Http__send Linear Linear 0 1 1 1 fieldname:_0 field:INT contract:N(a)
GENFN_CTOR yona_Std_Http__send Request Request 0 4 1 4 fieldname:method field:ADT shape:ADT contract:N(Method) fieldname:path field:STRING shape:STRING contract:N(String) fieldname:headers field:INT shape:INT contract:N(Int) fieldname:body field:STRING shape:STRING contract:N(String)
GENFN_CTOR yona_Std_Http__send Response Response 0 3 1 3 fieldname:status field:INT shape:INT contract:N(Int) fieldname:rawHeaders field:STRING shape:STRING contract:N(String) fieldname:body field:STRING shape:STRING contract:N(String)
GENFN_BEGIN yona_Std_Http__send send
send : String -> Int -> Request -> Response
send host port req =
    import tcpConnect, send as netSend, recv, close from Std\Net in
    case tcpConnect host port of
        Linear fd -> do
            netSend fd (formatRequest host req)
            raw = recv fd 65536
            close fd
            parseResponse raw
        end
    end
GENFN_END
GENFN_CTOR yona_Std_Http__serve Linear Linear 0 1 1 1 fieldname:_0 field:INT contract:N(a)
GENFN_CTOR yona_Std_Http__serve Request Request 0 4 1 4 fieldname:method field:ADT shape:ADT contract:N(Method) fieldname:path field:STRING shape:STRING contract:N(String) fieldname:headers field:INT shape:INT contract:N(Int) fieldname:body field:STRING shape:STRING contract:N(String)
GENFN_CTOR yona_Std_Http__serve Response Response 0 3 1 3 fieldname:status field:INT shape:INT contract:N(Int) fieldname:rawHeaders field:STRING shape:STRING contract:N(String) fieldname:body field:STRING shape:STRING contract:N(String)
GENFN_BEGIN yona_Std_Http__serve serve
serve : String -> Int -> (Request -> Response) -> Int
serve host port handler =
    import tcpListen from Std\Net in
    case tcpListen host port of
        Linear listener -> serveLoop listener handler
    end
GENFN_END
GENFN_CTOR yona_Std_Http__serverError Response Response 0 3 1 3 fieldname:status field:INT shape:INT contract:N(Int) fieldname:rawHeaders field:STRING shape:STRING contract:N(String) fieldname:body field:STRING shape:STRING contract:N(String)
GENFN_BEGIN yona_Std_Http__serverError serverError
serverError = Response { status = 500, rawHeaders = "", body = "Internal Server Error" }
GENFN_END
