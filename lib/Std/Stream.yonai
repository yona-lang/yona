MODULE Std\Stream
ADT Stream 2 2 recursive params a
  CTOR Yield 0 2 fields _0:VAR(a) _1:FUNCTION(UNIT,ADT(Stream,VAR(a)))
  CTOR Nil 1 0
FN allMatch 2 FUNCTION ADT -> INT borrow 10 effects | hof effectscheme $##;$/p##f0;$/r##f0
FN anyMatch 2 FUNCTION ADT -> BOOL borrow 10 effects | hof effectscheme $##;$/p##f0;$/r##f0
FN bracket 3 FUNCTION FUNCTION FUNCTION -> ADT borrow 101 effects | hof effectscheme $##;$/p##f0;$/r##;$/r/p##f1;$/r/r##f0|f2|f3;$/r/r/p##f3
FN chunksOf 2 INT ADT -> ADT effects - effectscheme $##;$/r##
FN concat 2 ADT ADT -> ADT effects - effectscheme $##;$/r##
FN count 1 ADT -> INT effects - effectscheme $##
FN drop 2 INT ADT -> ADT borrow 10 effects - effectscheme $##;$/r##
FN dropWhile 2 FUNCTION ADT -> INT borrow 10 effects | hof effectscheme $##;$/p##f0;$/r##f0
FN empty 0 -> ADT(Stream) effects - effectscheme $##
FN filter 2 FUNCTION ADT -> ADT effects | hof effectscheme $##;$/p##f0;$/r##f0
FN find 2 FUNCTION ADT -> ADT borrow 10 effects | hof effectscheme $##;$/p##f0;$/r##f0
FN flatMap 2 FUNCTION ADT -> ADT effects | hof effectscheme $##;$/p##f0;$/r##f0
FN foldl 3 FUNCTION INT ADT -> INT borrow 100 effects | hof effectscheme $##;$/p##f0;$/p/r##f1;$/r##;$/r/r##f0|f1
FN forEach 2 FUNCTION ADT -> INT borrow 10 effects | hof effectscheme $##;$/p##f0;$/r##f0
FN fromIterator 1 ADT -> ADT effects - effectscheme $##
FN fromSeq 1 SEQ -> ADT effects - effectscheme $##
FN head 1 ADT -> ADT effects - effectscheme $##
FN isEmpty 1 ADT -> BOOL effects - effectscheme $##
FN iterate 2 FUNCTION INT -> ADT(Stream) effects - hof effectscheme $##;$/p##f0;$/r##
FN map 2 FUNCTION ADT -> ADT effects | hof effectscheme $##;$/p##f0;$/r##f0
FN naturals 0 -> ADT effects - effectscheme $##
FN range 2 INT INT -> ADT effects - effectscheme $##;$/r##
FN repeat 1 INT -> ADT(Stream) effects - effectscheme $##
FN scan 3 FUNCTION INT ADT -> ADT effects | hof effectscheme $##;$/p##f0;$/p/r##f1;$/r##;$/r/r##f0|f1
FN singleton 1 INT -> ADT(Stream) effects - effectscheme $##
FN sum 1 ADT -> INT effects - effectscheme $##
FN take 2 INT ADT -> ADT effects - effectscheme $##;$/r##
FN takeWhile 2 FUNCTION ADT -> ADT effects | hof effectscheme $##;$/p##f0;$/r##f0
FN toSeq 1 ADT -> SEQ effects - effectscheme $##
FN unfold 2 FUNCTION INT -> ADT effects | hof effectscheme $##;$/p##f0;$/r##f0
FN zip 2 ADT ADT -> ADT effects - effectscheme $##;$/r##
FN zipWith 3 FUNCTION ADT ADT -> ADT effects | hof effectscheme $##;$/p##f0;$/p/r##f1;$/r##;$/r/r##f0|f1
GENFN_CTOR allMatch Yield Stream 0 2 2 2 recursive fields _0:VAR(a) _1:FUNCTION(UNIT,ADT(Stream,VAR(a)))
GENFN_CTOR allMatch Nil Stream 1 0 2 2 recursive
GENFN_CTOR allMatch None Option 1 0 2 1
GENFN_BEGIN allMatch allMatch
allMatch pred s = case s of
    Yield x rest -> if pred x then allMatch pred (rest ()) else false
    Nil          -> true
end
GENFN_END
GENFN_CTOR anyMatch Yield Stream 0 2 2 2 recursive fields _0:VAR(a) _1:FUNCTION(UNIT,ADT(Stream,VAR(a)))
GENFN_CTOR anyMatch Nil Stream 1 0 2 2 recursive
GENFN_BEGIN anyMatch anyMatch
anyMatch pred s = case s of
    Yield x rest -> if pred x then true else anyMatch pred (rest ())
    Nil          -> false
end
GENFN_END
GENFN_CTOR bracket Linear Linear 0 1 1 1 fields _0:VAR(a)
GENFN_CTOR bracket Yield Stream 0 2 2 2 recursive fields _0:VAR(a) _1:FUNCTION(UNIT,ADT(Stream,VAR(a)))
GENFN_CTOR bracket Nil Stream 1 0 2 2 recursive
GENFN_BEGIN bracket bracket
bracket acquire release produce =
    let r = acquire 0
    in let wrap t = case t of
            Yield x rest -> Yield x (\_ -> wrap (rest ()))
            Nil          -> let _ = release r in Nil
        end
    in wrap (produce r)
GENFN_END
GENFN_CTOR chunksOf Yield Stream 0 2 2 2 recursive fields _0:VAR(a) _1:FUNCTION(UNIT,ADT(Stream,VAR(a)))
GENFN_CTOR chunksOf Nil Stream 1 0 2 2 recursive
GENFN_BEGIN chunksOf chunksOf
chunksOf n s =
    if n <= 0 then Nil
    else let
        go count acc t = case t of
            Yield x rest ->
                let acc2 = acc ++ [x] in
                if count + 1 >= n
                then Yield acc2 (\_ -> go 0 [] (rest ()))
                else go (count + 1) acc2 (rest ())
            Nil -> if count == 0 then Nil
                   else Yield acc (\_ -> Nil)
        end
    in go 0 [] s
GENFN_END
GENFN_CTOR concat Yield Stream 0 2 2 2 recursive fields _0:VAR(a) _1:FUNCTION(UNIT,ADT(Stream,VAR(a)))
GENFN_CTOR concat Nil Stream 1 0 2 2 recursive
GENFN_BEGIN concat concat
concat a b = case a of
    Yield x rest -> Yield x (\_ -> concat (rest ()) b)
    Nil          -> b
end
GENFN_END
GENFN_BEGIN count count
count s = foldl (\acc _ -> acc + 1) 0 s
GENFN_END
GENFN_CTOR drop Yield Stream 0 2 2 2 recursive fields _0:VAR(a) _1:FUNCTION(UNIT,ADT(Stream,VAR(a)))
GENFN_CTOR drop Nil Stream 1 0 2 2 recursive
GENFN_BEGIN drop drop
drop n s =
    if n <= 0 then s
    else case s of
        Yield _ rest -> drop (n - 1) (rest ())
        Nil          -> Nil
    end
GENFN_END
GENFN_CTOR dropWhile Yield Stream 0 2 2 2 recursive fields _0:VAR(a) _1:FUNCTION(UNIT,ADT(Stream,VAR(a)))
GENFN_CTOR dropWhile Nil Stream 1 0 2 2 recursive
GENFN_BEGIN dropWhile dropWhile
dropWhile pred s = case s of
    Yield x rest -> if pred x then dropWhile pred (rest ())
                    else Yield x rest
    Nil          -> Nil
end
GENFN_END
GENFN_CTOR empty Nil Stream 1 0 2 2 recursive
GENFN_BEGIN empty empty
empty = Nil
GENFN_END
GENFN_CTOR filter Yield Stream 0 2 2 2 recursive fields _0:VAR(a) _1:FUNCTION(UNIT,ADT(Stream,VAR(a)))
GENFN_CTOR filter Nil Stream 1 0 2 2 recursive
GENFN_BEGIN filter filter
filter pred s = case s of
    Yield x rest -> if pred x then Yield x (\_ -> filter pred (rest ()))
                    else filter pred (rest ())
    Nil          -> Nil
end
GENFN_END
GENFN_CTOR find Some Option 0 1 2 1 fields _0:VAR(a)
GENFN_CTOR find Yield Stream 0 2 2 2 recursive fields _0:VAR(a) _1:FUNCTION(UNIT,ADT(Stream,VAR(a)))
GENFN_CTOR find Nil Stream 1 0 2 2 recursive
GENFN_CTOR find None Option 1 0 2 1
GENFN_BEGIN find find
find pred s = case s of
    Yield x rest -> if pred x then Some x else find pred (rest ())
    Nil          -> None
end
GENFN_END
GENFN_CTOR flatMap Yield Stream 0 2 2 2 recursive fields _0:VAR(a) _1:FUNCTION(UNIT,ADT(Stream,VAR(a)))
GENFN_CTOR flatMap Nil Stream 1 0 2 2 recursive
GENFN_BEGIN flatMap flatMap
flatMap fn s = case s of
    Yield x rest -> concat (fn x) (flatMap fn (rest ()))
    Nil          -> Nil
end
GENFN_END
GENFN_CTOR foldl Yield Stream 0 2 2 2 recursive fields _0:VAR(a) _1:FUNCTION(UNIT,ADT(Stream,VAR(a)))
GENFN_CTOR foldl Nil Stream 1 0 2 2 recursive
GENFN_BEGIN foldl foldl
foldl fn z s = case s of
    Yield x rest -> foldl fn (fn z x) (rest ())
    Nil          -> z
end
GENFN_END
GENFN_CTOR forEach Yield Stream 0 2 2 2 recursive fields _0:VAR(a) _1:FUNCTION(UNIT,ADT(Stream,VAR(a)))
GENFN_CTOR forEach Nil Stream 1 0 2 2 recursive
GENFN_BEGIN forEach forEach
forEach fn s = case s of
    Yield x rest -> let _ = fn x in forEach fn (rest ())
    Nil          -> ()
end
GENFN_END
GENFN_CTOR fromIterator Iterator Iterator 0 1 1 1 recursive fields _0:FUNCTION(UNIT,ADT(Option,VAR(a)))
GENFN_CTOR fromIterator Some Option 0 1 2 1 fields _0:VAR(a)
GENFN_CTOR fromIterator Yield Stream 0 2 2 2 recursive fields _0:VAR(a) _1:FUNCTION(UNIT,ADT(Stream,VAR(a)))
GENFN_CTOR fromIterator Nil Stream 1 0 2 2 recursive
GENFN_CTOR fromIterator None Option 1 0 2 1
GENFN_BEGIN fromIterator fromIterator
fromIterator iter = case iter of
    Iterator nextFn -> case nextFn () of
        Some x -> Yield x (\_ -> fromIterator iter)
        None   -> Nil
    end
end
GENFN_END
GENFN_CTOR fromSeq Yield Stream 0 2 2 2 recursive fields _0:VAR(a) _1:FUNCTION(UNIT,ADT(Stream,VAR(a)))
GENFN_CTOR fromSeq Nil Stream 1 0 2 2 recursive
GENFN_BEGIN fromSeq fromSeq
fromSeq xs = case xs of
    []    -> Nil
    [h|t] -> Yield h (\_ -> fromSeq t)
end
GENFN_END
GENFN_CTOR head Some Option 0 1 2 1 fields _0:VAR(a)
GENFN_CTOR head Yield Stream 0 2 2 2 recursive fields _0:VAR(a) _1:FUNCTION(UNIT,ADT(Stream,VAR(a)))
GENFN_CTOR head Nil Stream 1 0 2 2 recursive
GENFN_CTOR head None Option 1 0 2 1
GENFN_BEGIN head head
head s = case s of
    Yield x _ -> Some x
    Nil       -> None
end
GENFN_END
GENFN_CTOR isEmpty Yield Stream 0 2 2 2 recursive fields _0:VAR(a) _1:FUNCTION(UNIT,ADT(Stream,VAR(a)))
GENFN_CTOR isEmpty Nil Stream 1 0 2 2 recursive
GENFN_BEGIN isEmpty isEmpty
isEmpty s = case s of
    Yield _ _ -> false
    Nil       -> true
end
GENFN_END
GENFN_CTOR iterate Some Option 0 1 2 1 fields _0:VAR(a)
GENFN_CTOR iterate Yield Stream 0 2 2 2 recursive fields _0:VAR(a) _1:FUNCTION(UNIT,ADT(Stream,VAR(a)))
GENFN_CTOR iterate None Option 1 0 2 1
GENFN_BEGIN iterate iterate
iterate f x = Yield x (\_ -> iterate f (f x))
GENFN_END
GENFN_CTOR map Yield Stream 0 2 2 2 recursive fields _0:VAR(a) _1:FUNCTION(UNIT,ADT(Stream,VAR(a)))
GENFN_CTOR map Nil Stream 1 0 2 2 recursive
GENFN_BEGIN map map
map fn s = case s of
    Yield x rest -> Yield (fn x) (\_ -> map fn (rest ()))
    Nil          -> Nil
end
GENFN_END
GENFN_BEGIN naturals naturals
naturals = import intMax from Std\Constants\Num in range 0 intMax
GENFN_END
GENFN_CTOR range Yield Stream 0 2 2 2 recursive fields _0:VAR(a) _1:FUNCTION(UNIT,ADT(Stream,VAR(a)))
GENFN_CTOR range Nil Stream 1 0 2 2 recursive
GENFN_BEGIN range range
range lo hi =
    if lo >= hi then Nil
    else Yield lo (\_ -> range (lo + 1) hi)
GENFN_END
GENFN_CTOR repeat Yield Stream 0 2 2 2 recursive fields _0:VAR(a) _1:FUNCTION(UNIT,ADT(Stream,VAR(a)))
GENFN_BEGIN repeat repeat
repeat x = Yield x (\_ -> repeat x)
GENFN_END
GENFN_CTOR scan Yield Stream 0 2 2 2 recursive fields _0:VAR(a) _1:FUNCTION(UNIT,ADT(Stream,VAR(a)))
GENFN_CTOR scan Nil Stream 1 0 2 2 recursive
GENFN_BEGIN scan scan
scan fn z s = case s of
    Yield x rest -> let z2 = fn z x in Yield z2 (\_ -> scan fn z2 (rest ()))
    Nil          -> Nil
end
GENFN_END
GENFN_CTOR singleton Yield Stream 0 2 2 2 recursive fields _0:VAR(a) _1:FUNCTION(UNIT,ADT(Stream,VAR(a)))
GENFN_CTOR singleton Nil Stream 1 0 2 2 recursive
GENFN_BEGIN singleton singleton
singleton x = Yield x (\_ -> Nil)
GENFN_END
GENFN_BEGIN sum sum
sum s = foldl (\acc x -> acc + x) 0 s
GENFN_END
GENFN_CTOR take Yield Stream 0 2 2 2 recursive fields _0:VAR(a) _1:FUNCTION(UNIT,ADT(Stream,VAR(a)))
GENFN_CTOR take Nil Stream 1 0 2 2 recursive
GENFN_BEGIN take take
take n s =
    if n <= 0 then Nil
    else case s of
        Yield x rest -> Yield x (\_ -> take (n - 1) (rest ()))
        Nil          -> Nil
    end
GENFN_END
GENFN_CTOR takeWhile Yield Stream 0 2 2 2 recursive fields _0:VAR(a) _1:FUNCTION(UNIT,ADT(Stream,VAR(a)))
GENFN_CTOR takeWhile Nil Stream 1 0 2 2 recursive
GENFN_BEGIN takeWhile takeWhile
takeWhile pred s = case s of
    Yield x rest -> if pred x then Yield x (\_ -> takeWhile pred (rest ()))
                    else Nil
    Nil          -> Nil
end
GENFN_END
GENFN_CTOR toSeq Yield Stream 0 2 2 2 recursive fields _0:VAR(a) _1:FUNCTION(UNIT,ADT(Stream,VAR(a)))
GENFN_CTOR toSeq Nil Stream 1 0 2 2 recursive
GENFN_BEGIN toSeq toSeq
toSeq s = case s of
    Yield x rest -> x :: toSeq (rest ())
    Nil          -> []
end
GENFN_END
GENFN_CTOR unfold Iterator Iterator 0 1 1 1 recursive fields _0:FUNCTION(UNIT,ADT(Option,VAR(a)))
GENFN_CTOR unfold Some Option 0 1 2 1 fields _0:VAR(a)
GENFN_CTOR unfold Yield Stream 0 2 2 2 recursive fields _0:VAR(a) _1:FUNCTION(UNIT,ADT(Stream,VAR(a)))
GENFN_CTOR unfold Nil Stream 1 0 2 2 recursive
GENFN_CTOR unfold None Option 1 0 2 1
GENFN_BEGIN unfold unfold
unfold step seed = case step seed of
    Some pair -> case pair of
        (x, next) -> Yield x (\_ -> unfold step next)
    end
    None -> Nil
end
GENFN_END
GENFN_CTOR zip Yield Stream 0 2 2 2 recursive fields _0:VAR(a) _1:FUNCTION(UNIT,ADT(Stream,VAR(a)))
GENFN_CTOR zip Nil Stream 1 0 2 2 recursive
GENFN_BEGIN zip zip
zip a b = case a of
    Yield x ra -> case b of
        Yield y rb -> Yield (x, y) (\_ -> zip (ra ()) (rb ()))
        Nil        -> Nil
    end
    Nil -> Nil
end
GENFN_END
GENFN_CTOR zipWith Yield Stream 0 2 2 2 recursive fields _0:VAR(a) _1:FUNCTION(UNIT,ADT(Stream,VAR(a)))
GENFN_CTOR zipWith Nil Stream 1 0 2 2 recursive
GENFN_BEGIN zipWith zipWith
zipWith fn a b = case a of
    Yield x ra -> case b of
        Yield y rb -> Yield (fn x y) (\_ -> zipWith fn (ra ()) (rb ()))
        Nil        -> Nil
    end
    Nil -> Nil
end
GENFN_END
