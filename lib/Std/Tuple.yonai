MODULE Std\Tuple
FN curry 3 FUNCTION INT INT -> TUPLE borrow 100
FN fst 1 TUPLE -> INT borrow 1
FN mapBoth 3 FUNCTION FUNCTION TUPLE -> TUPLE borrow 001
FN mapFst 2 FUNCTION TUPLE -> TUPLE borrow 01
FN mapSnd 2 FUNCTION TUPLE -> TUPLE borrow 01
FN snd 1 TUPLE -> INT borrow 1
FN swap 1 TUPLE -> TUPLE borrow 1
FN toList 1 TUPLE -> SEQ borrow 1
FN uncurry 2 FUNCTION TUPLE -> INT borrow 11
GENFN_BEGIN curry curry
curry f a b = f (a, b)
GENFN_END
GENFN_BEGIN fst fst
fst (a, _) = a
GENFN_END
GENFN_BEGIN mapBoth mapBoth
mapBoth f g (a, b) = (f a, g b)
GENFN_END
GENFN_BEGIN mapFst mapFst
mapFst f (a, b) = (f a, b)
GENFN_END
GENFN_BEGIN mapSnd mapSnd
mapSnd f (a, b) = (a, f b)
GENFN_END
GENFN_BEGIN snd snd
snd (_, b) = b
GENFN_END
GENFN_BEGIN swap swap
swap (a, b) = (b, a)
GENFN_END
GENFN_BEGIN toList toList
toList (a, b) = [a, b]
GENFN_END
GENFN_BEGIN uncurry uncurry
uncurry f (a, b) = f a b
GENFN_END
