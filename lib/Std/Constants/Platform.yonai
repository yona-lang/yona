MODULE Std\Constants\Platform
FN arch 0 -> STRING effects - effectscheme $##
FN cacheLineSize 0 -> INT effects - effectscheme $##
FN cpuCount 0 -> INT effects - effectscheme $##
FN endianness 0 -> SYMBOL effects - effectscheme $##
FN isLittleEndian 0 -> INT effects - effectscheme $##
FN lineSeparator 0 -> STRING effects - effectscheme $##
FN nameMax 0 -> INT effects - effectscheme $##
FN nullDevice 0 -> STRING effects - effectscheme $##
FN osName 0 -> STRING effects - effectscheme $##
FN pageSize 0 -> INT effects - effectscheme $##
FN pathListSeparator 0 -> STRING effects - effectscheme $##
FN pathMax 0 -> INT effects - effectscheme $##
FN pathSeparator 0 -> STRING effects - effectscheme $##
FN wordSize 0 -> INT effects - effectscheme $##
GENFN_DEP arch platformArchNative NATIVE YonaRuntimePlatformArchitecture FN 1 INT -> STRING
GENFN_BEGIN arch arch
arch = platformArchNative 0
GENFN_END
GENFN_DEP cacheLineSize platformCacheLineSizeNative NATIVE YonaRuntimePlatformCacheLineSize FN 1 INT -> INT
GENFN_BEGIN cacheLineSize cacheLineSize
cacheLineSize = platformCacheLineSizeNative 0
GENFN_END
GENFN_DEP cpuCount platformCpuCountNative NATIVE YonaRuntimePlatformCpuCount FN 1 INT -> INT
GENFN_BEGIN cpuCount cpuCount
cpuCount = platformCpuCountNative 0
GENFN_END
GENFN_BEGIN endianness endianness
endianness = if isLittleEndian == 1 then :little else :big
GENFN_END
GENFN_DEP isLittleEndian platformIsLittleEndianNative NATIVE YonaRuntimePlatformIsLittleEndian FN 1 INT -> INT
GENFN_BEGIN isLittleEndian isLittleEndian
isLittleEndian = platformIsLittleEndianNative 0
GENFN_END
GENFN_BEGIN lineSeparator lineSeparator
lineSeparator = "\n"
GENFN_END
GENFN_DEP nameMax platformNameMaxNative NATIVE YonaRuntimePlatformMaximumNameLength FN 1 INT -> INT
GENFN_BEGIN nameMax nameMax
nameMax = platformNameMaxNative 0
GENFN_END
GENFN_BEGIN nullDevice nullDevice
nullDevice = "/dev/null"
GENFN_END
GENFN_DEP osName platformOsNameNative NATIVE YonaRuntimePlatformOsName FN 1 INT -> STRING
GENFN_BEGIN osName osName
osName = platformOsNameNative 0
GENFN_END
GENFN_DEP pageSize platformPageSizeNative NATIVE YonaRuntimePlatformPageSize FN 1 INT -> INT
GENFN_BEGIN pageSize pageSize
pageSize = platformPageSizeNative 0
GENFN_END
GENFN_BEGIN pathListSeparator pathListSeparator
pathListSeparator = ":"
GENFN_END
GENFN_DEP pathMax platformPathMaxNative NATIVE YonaRuntimePlatformMaximumPathLength FN 1 INT -> INT
GENFN_BEGIN pathMax pathMax
pathMax = platformPathMaxNative 0
GENFN_END
GENFN_BEGIN pathSeparator pathSeparator
pathSeparator = "/"
GENFN_END
GENFN_BEGIN wordSize wordSize
wordSize = 64
GENFN_END
