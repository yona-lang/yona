MODULE Std\Pair
ADT Pair 1 2
  CTOR Pair 0 2 fields fst:INT snd:INT
FN first 1 ADT -> INT
FN fromTuple 1 TUPLE -> ADT(Pair) borrow 1
FN mapFirst 2 FUNCTION ADT -> ADT
FN mapPair 3 FUNCTION FUNCTION ADT -> ADT
FN mapSecond 2 FUNCTION ADT -> ADT
FN pair 2 INT INT -> ADT(Pair)
FN second 1 ADT -> INT
FN swap 1 ADT -> ADT
FN toTuple 1 ADT -> TUPLE
GENFN_BEGIN first first
first p = case p of Pair { fst = a } -> a end
GENFN_END
GENFN_BEGIN fromTuple fromTuple
fromTuple (a, b) = Pair { fst = a, snd = b }
GENFN_END
GENFN_BEGIN mapFirst mapFirst
mapFirst fn p =
    case p of
        Pair { fst = a, snd = b } -> Pair { fst = fn a, snd = b }
    end
GENFN_END
GENFN_BEGIN mapPair mapPair
mapPair fn gn p =
    case p of
        Pair { fst = a, snd = b } -> Pair { fst = fn a, snd = gn b }
    end
GENFN_END
GENFN_BEGIN mapSecond mapSecond
mapSecond fn p =
    case p of
        Pair { fst = a, snd = b } -> Pair { fst = a, snd = fn b }
    end
GENFN_END
GENFN_BEGIN pair pair
pair a b = Pair { fst = a, snd = b }
GENFN_END
GENFN_BEGIN second second
second p = case p of Pair { snd = b } -> b end
GENFN_END
GENFN_BEGIN swap swap
swap p =
    case p of
        Pair { fst = a, snd = b } -> Pair { fst = b, snd = a }
    end
GENFN_END
GENFN_BEGIN toTuple toTuple
toTuple p =
    case p of
        Pair { fst = a, snd = b } -> (a, b)
    end
GENFN_END
