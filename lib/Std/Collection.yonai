MODULE Std\Collection
FN chunks 2 INT SEQ -> SEQ effects - effectscheme $##;$/r##
FN dedup 1 SEQ -> SEQ effects - effectscheme $##
FN frequencies 1 SEQ -> SEQ effects - effectscheme $##
FN iterate 3 INT FUNCTION INT -> SEQ effects | effectscheme $##;$/r##;$/r/p##f0;$/r/r##f0
FN pairwise 1 SEQ -> SEQ effects - effectscheme $##
FN replicate 2 INT INT -> SEQ effects - effectscheme $##;$/r##
FN tabulate 2 INT FUNCTION -> SEQ effects | effectscheme $##;$/r##f0;$/r/p##f1
FN unfold 2 FUNCTION(VAR(state),ADT(Option,TUPLE(VAR(value),VAR(state)))) VAR(state) -> Seq(VAR(value)) effects - hof effectscheme $##;$/p##;$/r##
FN window 2 INT SEQ -> SEQ effects - effectscheme $##;$/r##
GENFN_BEGIN chunks chunks
chunks size seq =
    let takeN n s = if n <= 0 then [] else case s of [] -> []; [h|t] -> h :: (takeN (n - 1) t) end in
    let dropN n s = if n <= 0 then s else case s of [] -> []; [_|t] -> dropN (n - 1) t end in
    case seq of
        [] -> []
        _  -> (takeN size seq) :: (chunks size (dropN size seq))
    end
GENFN_END
GENFN_BEGIN dedup dedup
dedup seq =
    case seq of
        [] -> []
        [h|t] -> case t of
            [] -> [h]
            [h2|_] -> if h == h2 then dedup t else h :: (dedup t)
        end
    end
GENFN_END
GENFN_BEGIN frequencies frequencies
frequencies seq =
    let update acc elem =
        let found = case acc of
            [] -> false
            [(k, _)|_] -> k == elem
        end in
        case acc of
            [] -> [(elem, 1)]
            [(k, v)|t] -> if k == elem then (k, v + 1) :: t
                          else (k, v) :: (update t elem)
        end
    in
    case seq of
        [] -> []
        [h|t] -> let result = update [] h in
                 case t of
                     [] -> result
                     _ -> let go acc s = case s of [] -> acc; [x|xs] -> go (update acc x) xs end in go result t
                 end
    end
GENFN_END
GENFN_CTOR iterate Some Option 0 1 2 1 fields _0:VAR(a)
GENFN_CTOR iterate None Option 1 0 2 1
GENFN_BEGIN iterate iterate
iterate n fn seed =
    if n <= 0 then []
    else seed :: (iterate (n - 1) fn (fn seed))
GENFN_END
GENFN_BEGIN pairwise pairwise
pairwise seq =
    case seq of
        [] -> []
        [_] -> []
        [a|[b|t]] -> (a, b) :: (pairwise (b :: t))
    end
GENFN_END
GENFN_BEGIN replicate replicate
replicate n value =
    if n <= 0 then []
    else value :: (replicate (n - 1) value)
GENFN_END
GENFN_BEGIN tabulate tabulate
tabulate n fn =
    let go i = if i >= n then [] else (fn i) :: (go (i + 1))
    in go 0
GENFN_END
GENFN_CTOR unfold Some Option 0 1 2 1 fields _0:VAR(a)
GENFN_CTOR unfold None Option 1 0 2 1
GENFN_BEGIN unfold unfold
unfold : (state -> Option (value, state)) -> state -> Seq value
unfold fn seed =
    case fn seed of
        Some pair -> case pair of
            (value, next) -> value :: (unfold fn next)
        end
        None -> []
    end
GENFN_END
GENFN_BEGIN window window
window size seq =
    let takeN n s = if n <= 0 then [] else case s of [] -> []; [h|t] -> h :: (takeN (n - 1) t) end in
    let len s = case s of [] -> 0; [_|t] -> 1 + (len t) end in
    if (len seq) < size then []
    else (takeN size seq) :: (window size (case seq of [_|t] -> t end))
GENFN_END
