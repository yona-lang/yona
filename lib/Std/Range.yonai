MODULE Std\Range
FN contains 2 INT TUPLE -> BOOL
FN drop 2 INT TUPLE -> TUPLE
FN filter 2 FUNCTION TUPLE -> SEQ
FN fold 3 FUNCTION INT TUPLE -> INT borrow 100
FN forEach 2 FUNCTION TUPLE -> SYMBOL borrow 10
FN length 1 TUPLE -> INT
FN map 2 FUNCTION TUPLE -> SEQ
FN range 2 INT INT -> TUPLE
FN rangeStep 3 INT INT INT -> TUPLE
FN take 2 INT TUPLE -> TUPLE
FN toList 1 TUPLE -> SEQ
GENFN_BEGIN contains contains
contains value r =
    case r of
        (:range, start, stop, step) ->
            if step > 0 then value >= start && value <= stop && (value - start) % step == 0
            else value <= start && value >= stop && (start - value) % (0 - step) == 0
    end
GENFN_END
GENFN_BEGIN drop drop
drop n r =
    case r of
        (:range, start, stop, step) ->
            let newStart = start + step * n in
            (:range, newStart, stop, step)
    end
GENFN_END
GENFN_BEGIN filter filter
filter pred r =
    case r of
        (:range, start, stop, step) ->
            if step > 0 then
                if start > stop then []
                else if pred start then start :: (filter pred (:range, start + step, stop, step))
                     else filter pred (:range, start + step, stop, step)
            else
                if start < stop then []
                else if pred start then start :: (filter pred (:range, start + step, stop, step))
                     else filter pred (:range, start + step, stop, step)
    end
GENFN_END
GENFN_BEGIN fold fold
fold fn acc r =
    case r of
        (:range, start, stop, step) ->
            if step > 0 then
                if start > stop then acc
                else fold fn (fn acc start) (:range, start + step, stop, step)
            else
                if start < stop then acc
                else fold fn (fn acc start) (:range, start + step, stop, step)
    end
GENFN_END
GENFN_BEGIN forEach forEach
forEach fn r =
    case r of
        (:range, start, stop, step) ->
            if step > 0 then
                if start > stop then :ok
                else do
                    fn start
                    forEach fn (:range, start + step, stop, step)
                end
            else
                if start < stop then :ok
                else do
                    fn start
                    forEach fn (:range, start + step, stop, step)
                end
    end
GENFN_END
GENFN_BEGIN length length
length r =
    case r of
        (:range, start, stop, step) ->
            if step > 0 then
                if stop >= start then (stop - start) / step + 1
                else 0
            else
                if start >= stop then (start - stop) / (0 - step) + 1
                else 0
    end
GENFN_END
GENFN_BEGIN map map
map fn r =
    case r of
        (:range, start, stop, step) ->
            if step > 0 then
                if start > stop then []
                else (fn start) :: (map fn (:range, start + step, stop, step))
            else
                if start < stop then []
                else (fn start) :: (map fn (:range, start + step, stop, step))
    end
GENFN_END
GENFN_BEGIN range range
range start stop = (:range, start, stop, 1)
GENFN_END
GENFN_BEGIN rangeStep rangeStep
rangeStep start stop step = (:range, start, stop, step)
GENFN_END
GENFN_BEGIN take take
take n r =
    case r of
        (:range, start, stop, step) ->
            let newStop = start + step * (n - 1) in
            if step > 0 then
                if newStop > stop then (:range, start, stop, step)
                else (:range, start, newStop, step)
            else
                if newStop < stop then (:range, start, stop, step)
                else (:range, start, newStop, step)
    end
GENFN_END
GENFN_BEGIN toList toList
toList r =
    case r of
        (:range, start, stop, step) ->
            if step > 0 then
                if start > stop then []
                else start :: (toList (:range, start + step, stop, step))
            else
                if start < stop then []
                else start :: (toList (:range, start + step, stop, step))
    end
GENFN_END
