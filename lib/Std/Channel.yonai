MODULE Std\Channel
ADT Receiver 1 1 params a
  CTOR Receiver 0 1 fields _0:ADT(Channel)
ADT Sender 1 1 params a
  CTOR Sender 0 1 fields _0:ADT(Channel)
INSTANCE Send Receiver
  PARAM value
INSTANCE Send Sender
  PARAM value
INSTANCE Shareable Receiver
  PARAM value
INSTANCE Shareable Sender
  PARAM value
FN capacity 1 ADT(Sender,VAR(a)) -> INT borrow 1 effects - effectscheme $##
FN channel 1 INT -> TUPLE(ADT(Linear,ADT(Sender,VAR(value))),ADT(Linear,ADT(Receiver,VAR(value))))
FN close 1 ADT(Sender,VAR(a)) -> UNIT borrow 1 effects - effectscheme $##
FN isClosed 1 ADT(Sender,VAR(a)) -> BOOL borrow 1 effects - effectscheme $##
FN length 1 ADT(Sender,VAR(a)) -> INT borrow 1 effects - effectscheme $##
FN recv 1 ADT(Receiver,VAR(a)) -> ADT(Option,VAR(a)) borrow 1 effects - effectscheme $##
FN send 2 ADT(Sender,VAR(a)) VAR(a) -> UNIT borrow 10 effects - effectscheme $##;$/r##
FN tryRecv 1 ADT(Receiver,VAR(a)) -> ADT(Option,VAR(a)) borrow 1 effects - effectscheme $##
GENFN_DEP capacity rawCapacity NATIVE YonaStdChannelRawCapacity FN 1 ADT(Channel) -> INT
GENFN_CTOR capacity Sender Sender 0 1 1 1 fields _0:ADT(Channel)
GENFN_BEGIN capacity capacity
capacity : Sender value -> Int
capacity (Sender raw) = rawCapacity raw
GENFN_END
GENFN_DEP close channel NATIVE YonaStdChannelChannel FN 1 INT -> TUPLE(ADT(Linear,ADT(Sender,VAR(value))),ADT(Linear,ADT(Receiver,VAR(value))))
GENFN_DEP close rawClose NATIVE YonaStdChannelRawClose FN 1 ADT(Channel) -> UNIT
GENFN_CTOR close Sender Sender 0 1 1 1 fields _0:ADT(Channel)
GENFN_BEGIN close close
close : Sender value -> Unit
close (Sender raw) = rawClose raw
GENFN_END
GENFN_DEP isClosed rawClosed NATIVE YonaStdChannelRawIsClosed FN 1 ADT(Channel) -> BOOL
GENFN_CTOR isClosed Sender Sender 0 1 1 1 fields _0:ADT(Channel)
GENFN_BEGIN isClosed isClosed
isClosed : Sender value -> Bool
isClosed (Sender raw) = rawClosed raw
GENFN_END
GENFN_DEP length rawLength NATIVE YonaStdChannelRawLength FN 1 ADT(Channel) -> INT
GENFN_CTOR length Sender Sender 0 1 1 1 fields _0:ADT(Channel)
GENFN_BEGIN length length
length : Sender value -> Int
length (Sender raw) = rawLength raw
GENFN_END
GENFN_DEP recv rawRecv NATIVE YonaStdChannelRawRecv FN 1 ADT(Channel) -> ADT(Option,VAR(value))
GENFN_CTOR recv Receiver Receiver 0 1 1 1 fields _0:ADT(Channel)
GENFN_BEGIN recv recv
recv : Receiver value -> Option value
recv (Receiver raw) = rawRecv raw
GENFN_END
GENFN_DEP send channel NATIVE YonaStdChannelChannel FN 1 INT -> TUPLE(ADT(Linear,ADT(Sender,VAR(value))),ADT(Linear,ADT(Receiver,VAR(value))))
GENFN_DEP send rawSend NATIVE YonaStdChannelRawSend FN 2 ADT(Channel) VAR(value) -> UNIT
GENFN_CTOR send Sender Sender 0 1 1 1 fields _0:ADT(Channel)
GENFN_CTOR send Some Option 0 1 2 1 fields _0:VAR(a)
GENFN_CTOR send None Option 1 0 2 1
GENFN_BEGIN send send
send : Sender value -> value -> Unit
send (Sender raw) value = rawSend raw value
GENFN_END
GENFN_DEP tryRecv rawTryRecv NATIVE YonaStdChannelRawTryRecv FN 1 ADT(Channel) -> ADT(Option,VAR(value))
GENFN_CTOR tryRecv Receiver Receiver 0 1 1 1 fields _0:ADT(Channel)
GENFN_BEGIN tryRecv tryRecv
tryRecv : Receiver value -> Option value
tryRecv (Receiver raw) = rawTryRecv raw
GENFN_END
