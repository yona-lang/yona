FN yona_Std_Option__filter 2 FUNCTION(VAR(a),BOOL) ADT(Option,VAR(a)) -> ADT(Option,VAR(a)) retadt Option borrow 10 effects | hof
FN yona_Std_Option__flatMap 2 FUNCTION(VAR(a),ADT(Option,VAR(b))) ADT(Option,VAR(a)) -> ADT(Option,VAR(b)) retadt Option borrow 10 effects | hof
FN yona_Std_Option__fold 3 VAR(b) FUNCTION(VAR(a),VAR(b)) ADT(Option,VAR(a)) -> VAR(b) retadt b borrow 010 effects |
FN yona_Std_Option__isNone 1 ADT(Option,VAR(a)) -> BOOL effects -
FN yona_Std_Option__isSome 1 ADT(Option,VAR(a)) -> BOOL effects -
FN yona_Std_Option__map 2 FUNCTION(VAR(a),VAR(b)) ADT(Option,VAR(a)) -> ADT(Option,VAR(b)) retadt Option borrow 10 effects | hof
FN yona_Std_Option__orElse 2 ADT(Option,VAR(a)) ADT(Option,VAR(a)) -> ADT(Option,VAR(a)) retadt Option effects -
FN yona_Std_Option__toResult 2 INT ADT -> TUPLE effects -
FN yona_Std_Option__unwrapOr 2 VAR(a) ADT(Option,VAR(a)) -> VAR(a) retadt a effects -
