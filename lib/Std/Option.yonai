GENFN_CTOR yona_Std_Option__filter None Option 1 0 2 1
GENFN_CTOR yona_Std_Option__filter Some Option 0 1 2 1 fieldname:_0 field:INT
GENFN_BEGIN yona_Std_Option__filter filter
filter : (a -> Bool) -> Option a -> Option a
filter pred opt =
    case opt of
        Some value -> if pred value then Some value else None
        None       -> None
    end
GENFN_END
GENFN_CTOR yona_Std_Option__flatMap None Option 1 0 2 1
GENFN_CTOR yona_Std_Option__flatMap Some Option 0 1 2 1 fieldname:_0 field:INT
GENFN_BEGIN yona_Std_Option__flatMap flatMap
flatMap : (a -> Option b) -> Option a -> Option b
flatMap fn opt =
    case opt of
        Some value -> fn value
        None       -> None
    end
GENFN_END
GENFN_CTOR yona_Std_Option__fold None Option 1 0 2 1
GENFN_CTOR yona_Std_Option__fold Some Option 0 1 2 1 fieldname:_0 field:INT
GENFN_BEGIN yona_Std_Option__fold fold
fold : b -> (a -> b) -> Option a -> b
fold onNone onSome opt =
    case opt of
        Some value -> onSome value
        None       -> onNone
    end
GENFN_END
GENFN_CTOR yona_Std_Option__isNone None Option 1 0 2 1
GENFN_CTOR yona_Std_Option__isNone Some Option 0 1 2 1 fieldname:_0 field:INT
GENFN_BEGIN yona_Std_Option__isNone isNone
isNone : Option a -> Bool
isNone opt =
    case opt of
        None   -> true
        Some _ -> false
    end
GENFN_END
GENFN_CTOR yona_Std_Option__isSome None Option 1 0 2 1
GENFN_CTOR yona_Std_Option__isSome Some Option 0 1 2 1 fieldname:_0 field:INT
GENFN_BEGIN yona_Std_Option__isSome isSome
isSome : Option a -> Bool
isSome opt =
    case opt of
        Some _ -> true
        None   -> false
    end
GENFN_END
GENFN_CTOR yona_Std_Option__map None Option 1 0 2 1
GENFN_CTOR yona_Std_Option__map Some Option 0 1 2 1 fieldname:_0 field:INT
GENFN_BEGIN yona_Std_Option__map map
map : (a -> b) -> Option a -> Option b
map fn opt =
    case opt of
        Some value -> Some (fn value)
        None       -> None
    end
GENFN_END
GENFN_CTOR yona_Std_Option__orElse None Option 1 0 2 1
GENFN_CTOR yona_Std_Option__orElse Some Option 0 1 2 1 fieldname:_0 field:INT
GENFN_BEGIN yona_Std_Option__orElse orElse
orElse : Option a -> Option a -> Option a
orElse alternative opt =
    case opt of
        Some value -> Some value
        None       -> alternative
    end
GENFN_END
GENFN_CTOR yona_Std_Option__toResult None Option 1 0 2 1
GENFN_CTOR yona_Std_Option__toResult Some Option 0 1 2 1 fieldname:_0 field:INT
GENFN_BEGIN yona_Std_Option__toResult toResult
toResult err opt =
    case opt of
        Some value -> (:ok, value)
        None       -> (:err, err)
    end
GENFN_END
GENFN_CTOR yona_Std_Option__unwrapOr None Option 1 0 2 1
GENFN_CTOR yona_Std_Option__unwrapOr Some Option 0 1 2 1 fieldname:_0 field:INT
GENFN_BEGIN yona_Std_Option__unwrapOr unwrapOr
unwrapOr : a -> Option a -> a
unwrapOr default opt =
    case opt of
        Some value -> value
        None       -> default
    end
GENFN_END
GENFN_CTOR yona_Std_Option__zip None Option 1 0 2 1
GENFN_CTOR yona_Std_Option__zip Some Option 0 1 2 1 fieldname:_0 field:INT
GENFN_BEGIN yona_Std_Option__zip zip
zip : Option a -> Option b -> Option (a, b)
zip optA optB =
    case optA of
        Some a -> case optB of
            Some b -> Some (a, b)
            None   -> None
        end
        None -> None
    end
GENFN_END
