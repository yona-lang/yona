MODULE Std\Option
FN filter 2 FUNCTION(VAR(a),BOOL) ADT(Option,VAR(a)) -> ADT(Option,VAR(a)) borrow 10 effects | hof
FN flatMap 2 FUNCTION(VAR(a),ADT(Option,VAR(b))) ADT(Option,VAR(a)) -> ADT(Option,VAR(b)) borrow 10 effects | hof
FN fold 3 VAR(b) FUNCTION(VAR(a),VAR(b)) ADT(Option,VAR(a)) -> VAR(b) borrow 010 effects |
FN isNone 1 ADT(Option,VAR(a)) -> BOOL effects -
FN isSome 1 ADT(Option,VAR(a)) -> BOOL effects -
FN map 2 FUNCTION(VAR(a),VAR(b)) ADT(Option,VAR(a)) -> ADT(Option,VAR(b)) borrow 10 effects | hof
FN orElse 2 ADT(Option,VAR(a)) ADT(Option,VAR(a)) -> ADT(Option,VAR(a)) effects -
FN toResult 2 INT ADT -> TUPLE effects -
FN unwrapOr 2 VAR(a) ADT(Option,VAR(a)) -> VAR(a) effects -
FN zip 2 ADT(Option,VAR(a)) ADT(Option,VAR(b)) -> ADT(Option,TUPLE(VAR(a),VAR(b))) effects -
GENFN_CTOR filter Some Option 0 1 2 1 fields _0:INT
GENFN_CTOR filter None Option 1 0 2 1
GENFN_BEGIN filter filter
filter : (a -> Bool) -> Option a -> Option a
filter pred opt =
    case opt of
        Some value -> if pred value then Some value else None
        None       -> None
    end
GENFN_END
GENFN_CTOR flatMap Some Option 0 1 2 1 fields _0:INT
GENFN_CTOR flatMap None Option 1 0 2 1
GENFN_BEGIN flatMap flatMap
flatMap : (a -> Option b) -> Option a -> Option b
flatMap fn opt =
    case opt of
        Some value -> fn value
        None       -> None
    end
GENFN_END
GENFN_CTOR fold Some Option 0 1 2 1 fields _0:INT
GENFN_CTOR fold None Option 1 0 2 1
GENFN_BEGIN fold fold
fold : b -> (a -> b) -> Option a -> b
fold onNone onSome opt =
    case opt of
        Some value -> onSome value
        None       -> onNone
    end
GENFN_END
GENFN_CTOR isNone Some Option 0 1 2 1 fields _0:INT
GENFN_CTOR isNone None Option 1 0 2 1
GENFN_BEGIN isNone isNone
isNone : Option a -> Bool
isNone opt =
    case opt of
        None   -> true
        Some _ -> false
    end
GENFN_END
GENFN_CTOR isSome Some Option 0 1 2 1 fields _0:INT
GENFN_CTOR isSome None Option 1 0 2 1
GENFN_BEGIN isSome isSome
isSome : Option a -> Bool
isSome opt =
    case opt of
        Some _ -> true
        None   -> false
    end
GENFN_END
GENFN_CTOR map Some Option 0 1 2 1 fields _0:INT
GENFN_CTOR map None Option 1 0 2 1
GENFN_BEGIN map map
map : (a -> b) -> Option a -> Option b
map fn opt =
    case opt of
        Some value -> Some (fn value)
        None       -> None
    end
GENFN_END
GENFN_CTOR orElse Some Option 0 1 2 1 fields _0:INT
GENFN_CTOR orElse None Option 1 0 2 1
GENFN_BEGIN orElse orElse
orElse : Option a -> Option a -> Option a
orElse alternative opt =
    case opt of
        Some value -> Some value
        None       -> alternative
    end
GENFN_END
GENFN_CTOR toResult Some Option 0 1 2 1 fields _0:INT
GENFN_CTOR toResult None Option 1 0 2 1
GENFN_BEGIN toResult toResult
toResult err opt =
    case opt of
        Some value -> (:ok, value)
        None       -> (:err, err)
    end
GENFN_END
GENFN_CTOR unwrapOr Some Option 0 1 2 1 fields _0:INT
GENFN_CTOR unwrapOr None Option 1 0 2 1
GENFN_BEGIN unwrapOr unwrapOr
unwrapOr : a -> Option a -> a
unwrapOr default opt =
    case opt of
        Some value -> value
        None       -> default
    end
GENFN_END
GENFN_CTOR zip Some Option 0 1 2 1 fields _0:INT
GENFN_CTOR zip None Option 1 0 2 1
GENFN_BEGIN zip zip
zip : Option a -> Option b -> Option (a, b)
zip optA optB =
    case optA of
        Some a -> case optB of
            Some b -> Some (a, b)
            None   -> None
        end
        None -> None
    end
GENFN_END
