MODULE Std\Regex
FN compile 1 STRING -> ADT(Regex)
FN find 2 ADT(Regex) STRING -> Seq(STRING) borrow 10
FN findAll 2 ADT(Regex) STRING -> Seq(Seq(STRING)) borrow 10
FN matches 2 ADT(Regex) STRING -> BOOL borrow 10
FN replace 3 ADT(Regex) STRING STRING -> STRING borrow 100
FN replaceAll 3 ADT(Regex) STRING STRING -> STRING borrow 100
FN split 2 ADT(Regex) STRING -> Seq(STRING) borrow 10
