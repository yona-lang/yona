MODULE Std\TraitLaws
FN eqLaws 4 STRING FUNCTION(VAR(a),STRING) FUNCTION(VAR(a),FUNCTION(VAR(a),BOOL)) Seq(VAR(a)) -> Seq(ADT(TestCase)) effects |
FN hashLaws 5 STRING FUNCTION(VAR(a),STRING) FUNCTION(VAR(a),FUNCTION(VAR(a),BOOL)) FUNCTION(VAR(a),INT) Seq(VAR(a)) -> Seq(ADT(TestCase)) effects |
FN monoidLaws 6 STRING FUNCTION(VAR(a),STRING) FUNCTION(VAR(a),FUNCTION(VAR(a),BOOL)) FUNCTION(VAR(a),FUNCTION(VAR(a),VAR(a))) VAR(a) Seq(VAR(a)) -> Seq(ADT(TestCase)) effects |
FN ordLaws 5 STRING FUNCTION(VAR(a),STRING) FUNCTION(VAR(a),FUNCTION(VAR(a),BOOL)) FUNCTION(VAR(a),FUNCTION(VAR(a),ADT(Ordering))) Seq(VAR(a)) -> Seq(ADT(TestCase)) effects |
FN semigroupLaws 5 STRING FUNCTION(VAR(a),STRING) FUNCTION(VAR(a),FUNCTION(VAR(a),BOOL)) FUNCTION(VAR(a),FUNCTION(VAR(a),VAR(a))) Seq(VAR(a)) -> Seq(ADT(TestCase)) effects |
FN showLaws 3 STRING FUNCTION(VAR(a),STRING) Seq(VAR(a)) -> Seq(ADT(TestCase)) effects |
GENFN_CTOR associativeFailure Some Option 0 1 2 1 fields _0:VAR(a)
GENFN_CTOR associativeFailure None Option 1 0 2 1
GENFN_BEGIN associativeFailure associativeFailure
associativeFailure : (a -> String) -> (a -> a -> Bool) -> (a -> a -> a) -> Seq a -> Int -> Int -> Option String
associativeFailure render equals append samples firstIndex count =
    if firstIndex >= count then None
    else case associativeFailureSecond render equals append samples firstIndex 0 count of
        None -> associativeFailure render equals append samples (firstIndex + 1) count
        Some message -> Some message
    end
GENFN_END
GENFN_CTOR associativeFailureSecond Some Option 0 1 2 1 fields _0:VAR(a)
GENFN_CTOR associativeFailureSecond None Option 1 0 2 1
GENFN_BEGIN associativeFailureSecond associativeFailureSecond
associativeFailureSecond : (a -> String) -> (a -> a -> Bool) -> (a -> a -> a) -> Seq a -> Int -> Int -> Int -> Option String
associativeFailureSecond render equals append samples firstIndex secondIndex count =
    if secondIndex >= count then None
    else case associativeFailureThird render equals append samples firstIndex secondIndex 0 count of
        None -> associativeFailureSecond render equals append samples firstIndex (secondIndex + 1) count
        Some message -> Some message
    end
GENFN_END
GENFN_CTOR associativeFailureThird Some Option 0 1 2 1 fields _0:VAR(a)
GENFN_CTOR associativeFailureThird None Option 1 0 2 1
GENFN_BEGIN associativeFailureThird associativeFailureThird
associativeFailureThird : (a -> String) -> (a -> a -> Bool) -> (a -> a -> a) -> Seq a -> Int -> Int -> Int -> Int -> Option String
associativeFailureThird render equals append samples firstIndex secondIndex thirdIndex count =
    if thirdIndex >= count then None
    else let first = get samples firstIndex,
             second = get samples secondIndex,
             third = get samples thirdIndex,
             left = append (append first second) third,
             right = append first (append second third)
         in if equals left right then
            associativeFailureThird render equals append samples firstIndex secondIndex (thirdIndex + 1) count
         else Some ("non-associative for " ++ render first ++ ", " ++ render second ++ ", " ++ render third)
GENFN_END
GENFN_CTOR eqLaws TestCase TestCase 0 2 1 2 recursive fields name:STRING thunk:FUNCTION(UNIT,ADT(TestResult))
GENFN_BEGIN eqLaws eqLaws
eqLaws : String -> (a -> String) -> (a -> a -> Bool) -> Seq a -> Seq TestCase
eqLaws label render equals samples = import testCase from Std\Test in
    let count = size samples in [
        testCase (label ++ " Eq reflexive") (\_ ->
            lawResult "reflexive" (reflexiveFailure render equals samples 0 count)),
        testCase (label ++ " Eq symmetric") (\_ ->
            lawResult "symmetric" (symmetricFailure render equals samples 0 count)),
        testCase (label ++ " Eq transitive") (\_ ->
            lawResult "transitive" (transitiveEqFailure render equals samples 0 count))
    ]
GENFN_END
GENFN_CTOR hashFailure Some Option 0 1 2 1 fields _0:VAR(a)
GENFN_CTOR hashFailure Equal Ordering 1 0 3 0
GENFN_CTOR hashFailure None Option 1 0 2 1
GENFN_BEGIN hashFailure hashFailure
hashFailure : (a -> String) -> (a -> a -> Bool) -> (a -> Int) -> Seq a -> Int -> Int -> Option String
hashFailure render equals hasher samples leftIndex count =
    if leftIndex >= count then None
    else case hashFailureAt render equals hasher samples leftIndex 0 count of
        None -> hashFailure render equals hasher samples (leftIndex + 1) count
        Some message -> Some message
    end
GENFN_END
GENFN_CTOR hashFailureAt Some Option 0 1 2 1 fields _0:VAR(a)
GENFN_CTOR hashFailureAt None Option 1 0 2 1
GENFN_BEGIN hashFailureAt hashFailureAt
hashFailureAt : (a -> String) -> (a -> a -> Bool) -> (a -> Int) -> Seq a -> Int -> Int -> Int -> Option String
hashFailureAt render equals hasher samples leftIndex rightIndex count =
    if rightIndex >= count then None
    else let left = get samples leftIndex, right = get samples rightIndex in
        if equals left right && hasher left != hasher right then
            Some ("equal values hash differently: " ++ render left ++ " and " ++ render right)
        else hashFailureAt render equals hasher samples leftIndex (rightIndex + 1) count
GENFN_END
GENFN_CTOR hashLaws TestCase TestCase 0 2 1 2 recursive fields name:STRING thunk:FUNCTION(UNIT,ADT(TestResult))
GENFN_BEGIN hashLaws hashLaws
hashLaws : String -> (a -> String) -> (a -> a -> Bool) ->
    (a -> Int) -> Seq a -> Seq TestCase
hashLaws label render equals hasher samples = import testCase from Std\Test in [
    testCase (label ++ " Hash agrees with Eq") (\_ ->
        lawResult "hash agreement" (hashFailure render equals hasher samples 0 (size samples)))
]
GENFN_END
GENFN_CTOR identityFailure Some Option 0 1 2 1 fields _0:VAR(a)
GENFN_CTOR identityFailure None Option 1 0 2 1
GENFN_BEGIN identityFailure identityFailure
identityFailure : (a -> String) -> (a -> a -> Bool) -> (a -> a -> a) -> a -> Seq a -> Int -> Int -> Option String
identityFailure @borrow render @borrow equals @borrow append @borrow emptyValue @borrow samples index count =
    if index >= count then None
    else let value = get samples index,
             leftCombined = append emptyValue value,
             rightCombined = append value emptyValue
         in if equals leftCombined value then
            if equals rightCombined value then
                identityFailure render equals append emptyValue samples (index + 1) count
            else Some ("right identity fails: " ++ render value ++ " <> empty = " ++ render rightCombined)
        else Some ("left identity fails: empty <> " ++ render value ++ " = " ++ render leftCombined)
GENFN_END
GENFN_CTOR lawResult Some Option 0 1 2 1 fields _0:VAR(a)
GENFN_CTOR lawResult None Option 1 0 2 1
GENFN_BEGIN lawResult lawResult
lawResult : String -> Option String -> TestResult
lawResult success failure = import pass, fail from Std\Test in
    case failure of None -> pass success; Some message -> fail message end
GENFN_END
GENFN_CTOR monoidLaws TestCase TestCase 0 2 1 2 recursive fields name:STRING thunk:FUNCTION(UNIT,ADT(TestResult))
GENFN_BEGIN monoidLaws monoidLaws
monoidLaws : String -> (a -> String) -> (a -> a -> Bool) ->
    (a -> a -> a) -> a -> Seq a -> Seq TestCase
monoidLaws label render equals append emptyValue samples = import testCase from Std\Test in [
    testCase (label ++ " Monoid identity") (\_ ->
        lawResult "identity" (identityFailure render equals append emptyValue samples 0 (size samples)))
]
GENFN_END
GENFN_CTOR opposite Less Ordering 0 0 3 0
GENFN_CTOR opposite Equal Ordering 1 0 3 0
GENFN_CTOR opposite Greater Ordering 2 0 3 0
GENFN_BEGIN opposite opposite
opposite : Ordering -> Ordering
opposite ordering = case ordering of Less -> Greater; Equal -> Equal; Greater -> Less end
GENFN_END
GENFN_CTOR ordLaws TestCase TestCase 0 2 1 2 recursive fields name:STRING thunk:FUNCTION(UNIT,ADT(TestResult))
GENFN_BEGIN ordLaws ordLaws
ordLaws : String -> (a -> String) -> (a -> a -> Bool) ->
    (a -> a -> Ordering) -> Seq a -> Seq TestCase
ordLaws label render equals compareValues samples = import testCase from Std\Test in
    let count = size samples in [
        testCase (label ++ " Ord agrees with Eq") (\_ ->
            lawResult "Eq agreement" (ordPairFailure render equals compareValues samples 0 count)),
        testCase (label ++ " Ord transitive") (\_ ->
            lawResult "transitive" (transitiveOrdFailure render compareValues samples 0 count))
    ]
GENFN_END
GENFN_CTOR ordPairFailure Some Option 0 1 2 1 fields _0:VAR(a)
GENFN_CTOR ordPairFailure None Option 1 0 2 1
GENFN_BEGIN ordPairFailure ordPairFailure
ordPairFailure : (a -> String) -> (a -> a -> Bool) -> (a -> a -> Ordering) -> Seq a -> Int -> Int -> Option String
ordPairFailure render equals compareValues samples leftIndex count =
    if leftIndex >= count then None
    else case ordPairFailureAt render equals compareValues samples leftIndex 0 count of
        None -> ordPairFailure render equals compareValues samples (leftIndex + 1) count
        Some message -> Some message
    end
GENFN_END
GENFN_CTOR ordPairFailureAt Some Option 0 1 2 1 fields _0:VAR(a)
GENFN_CTOR ordPairFailureAt Equal Ordering 1 0 3 0
GENFN_CTOR ordPairFailureAt None Option 1 0 2 1
GENFN_BEGIN ordPairFailureAt ordPairFailureAt
ordPairFailureAt : (a -> String) -> (a -> a -> Bool) -> (a -> a -> Ordering) -> Seq a -> Int -> Int -> Int -> Option String
ordPairFailureAt render equals compareValues samples leftIndex rightIndex count =
    if rightIndex >= count then None
    else let left = get samples leftIndex,
             right = get samples rightIndex,
             forward = compareValues left right,
             backward = compareValues right left
         in if (forward == Equal) != equals left right then
            Some ("compare/Eq disagreement for " ++ render left ++ " and " ++ render right)
         else if backward != opposite forward then
            Some ("reversing operands is inconsistent for " ++ render left ++ " and " ++ render right)
         else ordPairFailureAt render equals compareValues samples leftIndex (rightIndex + 1) count
GENFN_END
GENFN_CTOR reflexiveFailure Some Option 0 1 2 1 fields _0:VAR(a)
GENFN_CTOR reflexiveFailure None Option 1 0 2 1
GENFN_BEGIN reflexiveFailure reflexiveFailure
reflexiveFailure : (a -> String) -> (a -> a -> Bool) -> Seq a -> Int -> Int -> Option String
reflexiveFailure render equals samples index count =
    if index >= count then None
    else let value = get samples index in
        if equals value value then reflexiveFailure render equals samples (index + 1) count
        else Some ("not reflexive for " ++ render value)
GENFN_END
GENFN_CTOR semigroupLaws TestCase TestCase 0 2 1 2 recursive fields name:STRING thunk:FUNCTION(UNIT,ADT(TestResult))
GENFN_BEGIN semigroupLaws semigroupLaws
semigroupLaws : String -> (a -> String) -> (a -> a -> Bool) ->
    (a -> a -> a) -> Seq a -> Seq TestCase
semigroupLaws label render equals append samples = import testCase from Std\Test in [
    testCase (label ++ " Semigroup associative") (\_ ->
        lawResult "associative" (associativeFailure render equals append samples 0 (size samples)))
]
GENFN_END
GENFN_CTOR showFailure Some Option 0 1 2 1 fields _0:VAR(a)
GENFN_CTOR showFailure None Option 1 0 2 1
GENFN_BEGIN showFailure showFailure
showFailure : (a -> String) -> Seq a -> Int -> Int -> Option String
showFailure renderer samples index count =
    if index >= count then None
    else let value = get samples index in
        if renderer value == renderer value then showFailure renderer samples (index + 1) count
        else Some ("rendering is unstable at sample " ++ renderer value)
GENFN_END
GENFN_CTOR showLaws TestCase TestCase 0 2 1 2 recursive fields name:STRING thunk:FUNCTION(UNIT,ADT(TestResult))
GENFN_BEGIN showLaws showLaws
showLaws : String -> (a -> String) -> Seq a -> Seq TestCase
showLaws label renderer samples = import testCase from Std\Test in [
    testCase (label ++ " Show deterministic") (\_ ->
        lawResult "deterministic" (showFailure renderer samples 0 (size samples)))
]
GENFN_END
GENFN_CTOR symmetricFailure Some Option 0 1 2 1 fields _0:VAR(a)
GENFN_CTOR symmetricFailure None Option 1 0 2 1
GENFN_BEGIN symmetricFailure symmetricFailure
symmetricFailure : (a -> String) -> (a -> a -> Bool) -> Seq a -> Int -> Int -> Option String
symmetricFailure render equals samples leftIndex count =
    if leftIndex >= count then None
    else case symmetricFailureAt render equals samples leftIndex 0 count of
        None -> symmetricFailure render equals samples (leftIndex + 1) count
        Some message -> Some message
    end
GENFN_END
GENFN_CTOR symmetricFailureAt Some Option 0 1 2 1 fields _0:VAR(a)
GENFN_CTOR symmetricFailureAt None Option 1 0 2 1
GENFN_BEGIN symmetricFailureAt symmetricFailureAt
symmetricFailureAt : (a -> String) -> (a -> a -> Bool) -> Seq a -> Int -> Int -> Int -> Option String
symmetricFailureAt render equals samples leftIndex rightIndex count =
    if rightIndex >= count then None
    else let left = get samples leftIndex, right = get samples rightIndex in
        if equals left right == equals right left then
            symmetricFailureAt render equals samples leftIndex (rightIndex + 1) count
        else Some ("asymmetric for " ++ render left ++ " and " ++ render right)
GENFN_END
GENFN_CTOR transitiveEqFailure Some Option 0 1 2 1 fields _0:VAR(a)
GENFN_CTOR transitiveEqFailure None Option 1 0 2 1
GENFN_BEGIN transitiveEqFailure transitiveEqFailure
transitiveEqFailure : (a -> String) -> (a -> a -> Bool) -> Seq a -> Int -> Int -> Option String
transitiveEqFailure render equals samples firstIndex count =
    if firstIndex >= count then None
    else case transitiveEqFailureSecond render equals samples firstIndex 0 count of
        None -> transitiveEqFailure render equals samples (firstIndex + 1) count
        Some message -> Some message
    end
GENFN_END
GENFN_CTOR transitiveEqFailureSecond Some Option 0 1 2 1 fields _0:VAR(a)
GENFN_CTOR transitiveEqFailureSecond None Option 1 0 2 1
GENFN_BEGIN transitiveEqFailureSecond transitiveEqFailureSecond
transitiveEqFailureSecond : (a -> String) -> (a -> a -> Bool) -> Seq a -> Int -> Int -> Int -> Option String
transitiveEqFailureSecond render equals samples firstIndex secondIndex count =
    if secondIndex >= count then None
    else case transitiveEqFailureThird render equals samples firstIndex secondIndex 0 count of
        None -> transitiveEqFailureSecond render equals samples firstIndex (secondIndex + 1) count
        Some message -> Some message
    end
GENFN_END
GENFN_CTOR transitiveEqFailureThird Some Option 0 1 2 1 fields _0:VAR(a)
GENFN_CTOR transitiveEqFailureThird None Option 1 0 2 1
GENFN_BEGIN transitiveEqFailureThird transitiveEqFailureThird
transitiveEqFailureThird : (a -> String) -> (a -> a -> Bool) -> Seq a -> Int -> Int -> Int -> Int -> Option String
transitiveEqFailureThird render equals samples firstIndex secondIndex thirdIndex count =
    if thirdIndex >= count then None
    else let first = get samples firstIndex,
             second = get samples secondIndex,
             third = get samples thirdIndex
         in if equals first second && equals second third && equals first third == false then
            Some ("non-transitive chain " ++ render first ++ ", " ++ render second ++ ", " ++ render third)
         else transitiveEqFailureThird render equals samples firstIndex secondIndex (thirdIndex + 1) count
GENFN_END
GENFN_CTOR transitiveOrdFailure Some Option 0 1 2 1 fields _0:VAR(a)
GENFN_CTOR transitiveOrdFailure None Option 1 0 2 1
GENFN_BEGIN transitiveOrdFailure transitiveOrdFailure
transitiveOrdFailure : (a -> String) -> (a -> a -> Ordering) -> Seq a -> Int -> Int -> Option String
transitiveOrdFailure render compareValues samples firstIndex count =
    if firstIndex >= count then None
    else case transitiveOrdFailureSecond render compareValues samples firstIndex 0 count of
        None -> transitiveOrdFailure render compareValues samples (firstIndex + 1) count
        Some message -> Some message
    end
GENFN_END
GENFN_CTOR transitiveOrdFailureSecond Some Option 0 1 2 1 fields _0:VAR(a)
GENFN_CTOR transitiveOrdFailureSecond None Option 1 0 2 1
GENFN_BEGIN transitiveOrdFailureSecond transitiveOrdFailureSecond
transitiveOrdFailureSecond : (a -> String) -> (a -> a -> Ordering) -> Seq a -> Int -> Int -> Int -> Option String
transitiveOrdFailureSecond render compareValues samples firstIndex secondIndex count =
    if secondIndex >= count then None
    else case transitiveOrdFailureThird render compareValues samples firstIndex secondIndex 0 count of
        None -> transitiveOrdFailureSecond render compareValues samples firstIndex (secondIndex + 1) count
        Some message -> Some message
    end
GENFN_END
GENFN_CTOR transitiveOrdFailureThird Some Option 0 1 2 1 fields _0:VAR(a)
GENFN_CTOR transitiveOrdFailureThird None Option 1 0 2 1
GENFN_CTOR transitiveOrdFailureThird Greater Ordering 2 0 3 0
GENFN_BEGIN transitiveOrdFailureThird transitiveOrdFailureThird
transitiveOrdFailureThird : (a -> String) -> (a -> a -> Ordering) -> Seq a -> Int -> Int -> Int -> Int -> Option String
transitiveOrdFailureThird render compareValues samples firstIndex secondIndex thirdIndex count =
    if thirdIndex >= count then None
    else let first = get samples firstIndex,
             second = get samples secondIndex,
             third = get samples thirdIndex,
             firstSecond = compareValues first second,
             secondThird = compareValues second third
         in if firstSecond != Greater && secondThird != Greater && compareValues first third == Greater then
            Some ("non-transitive order " ++ render first ++ ", " ++ render second ++ ", " ++ render third)
         else transitiveOrdFailureThird render compareValues samples firstIndex secondIndex (thirdIndex + 1) count
GENFN_END
