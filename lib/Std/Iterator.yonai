GENFN_BEGIN yona_Std_Iterator__next next
next : Iterator element -> Option element
next @borrow iterator = nextNative iterator
GENFN_END
GENFN_BEGIN yona_Std_Iterator__reverseInto reverseInto
reverseInto : Seq element -> Seq element -> Seq element
reverseInto values accumulator =
    case values of
        [head|tail] -> reverseInto tail (head :: accumulator)
        [] -> accumulator
    end
GENFN_END
GENFN_CTOR yona_Std_Iterator__toSeq Iterator Iterator 0 1 1 1 recursive fieldname:_0 field:FUNCTION:ADT:Option contract:F(N(%28%29);N(Option,N(a)))
GENFN_BEGIN yona_Std_Iterator__toSeq toSeq
toSeq : Iterator element -> Seq element
toSeq iterator = collect iterator []
GENFN_END
