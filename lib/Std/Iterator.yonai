MODULE Std\Iterator
FN foldLeft 3 ADT(Iterator,VAR(element)) FUNCTION(VAR(acc),FUNCTION(VAR(element),VAR(acc))) VAR(acc) -> VAR(acc) effects |
FN fromByteArray 1 BYTE_ARRAY -> ADT(Iterator,INT)
FN fromFloatArray 1 FLOAT_ARRAY -> ADT(Iterator,FLOAT)
FN fromIntArray 1 INT_ARRAY -> ADT(Iterator,INT)
FN fromSeq 1 Seq(VAR(element)) -> ADT(Iterator,VAR(element))
FN next 1 ADT(Iterator,VAR(element)) -> ADT(Option,VAR(element)) borrow 1 effects -
FN toSeq 1 ADT(Iterator,VAR(element)) -> Seq(VAR(element)) effects |
GENFN_CTOR collect Iterator Iterator 0 1 1 1 recursive fields _0:FUNCTION(UNIT,ADT(Option,VAR(a)))
GENFN_CTOR collect Some Option 0 1 2 1 fields _0:VAR(a)
GENFN_CTOR collect None Option 1 0 2 1
GENFN_BEGIN collect collect
collect : Iterator element -> Seq element -> Seq element
collect iterator accumulator =
    case next iterator of
        Some value -> collect iterator (value :: accumulator)
        None -> reverseInto accumulator []
    end
GENFN_END
GENFN_CTOR foldLeft Iterator Iterator 0 1 1 1 recursive fields _0:FUNCTION(UNIT,ADT(Option,VAR(a)))
GENFN_CTOR foldLeft Some Option 0 1 2 1 fields _0:VAR(a)
GENFN_CTOR foldLeft None Option 1 0 2 1
GENFN_BEGIN foldLeft foldLeft
foldLeft : Iterator element -> (acc -> element -> acc) -> acc -> acc
foldLeft iterator folder accumulator =
    case next iterator of
        Some value -> foldLeft iterator folder (folder accumulator value)
        None -> accumulator
    end
GENFN_END
GENFN_DEP next nextNative NATIVE YonaStdIteratorNextNative FN 1 ADT(Iterator,VAR(element)) -> ADT(Option,VAR(element))
GENFN_CTOR next Iterator Iterator 0 1 1 1 recursive fields _0:FUNCTION(UNIT,ADT(Option,VAR(a)))
GENFN_BEGIN next next
next : Iterator element -> Option element
next @borrow iterator = nextNative iterator
GENFN_END
GENFN_BEGIN reverseInto reverseInto
reverseInto : Seq element -> Seq element -> Seq element
reverseInto values accumulator =
    case values of
        [head|tail] -> reverseInto tail (head :: accumulator)
        [] -> accumulator
    end
GENFN_END
GENFN_CTOR toSeq Iterator Iterator 0 1 1 1 recursive fields _0:FUNCTION(UNIT,ADT(Option,VAR(a)))
GENFN_BEGIN toSeq toSeq
toSeq : Iterator element -> Seq element
toSeq iterator = collect iterator []
GENFN_END
