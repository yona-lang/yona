GENFN_CTOR yona_Std_Iterator__collect Iterator Iterator 0 1 1 1 recursive fieldname:_0 field:FUNCTION:ADT:Option contract:F(N(%28%29);N(Option,N(a)))
GENFN_CTOR yona_Std_Iterator__collect None Option 1 0 2 1
GENFN_CTOR yona_Std_Iterator__collect Some Option 0 1 2 1 fieldname:_0 field:INT contract:N(a)
GENFN_BEGIN yona_Std_Iterator__collect collect
collect : Iterator element -> Seq element -> Seq element
collect iterator accumulator =
    case next iterator of
        Some value -> collect iterator (value :: accumulator)
        None -> reverseInto accumulator []
    end
GENFN_END
GENFN_CTOR yona_Std_Iterator__foldLeft Iterator Iterator 0 1 1 1 recursive fieldname:_0 field:FUNCTION:ADT:Option contract:F(N(%28%29);N(Option,N(a)))
GENFN_CTOR yona_Std_Iterator__foldLeft None Option 1 0 2 1
GENFN_CTOR yona_Std_Iterator__foldLeft Some Option 0 1 2 1 fieldname:_0 field:INT contract:N(a)
GENFN_BEGIN yona_Std_Iterator__foldLeft foldLeft
foldLeft : Iterator element -> (acc -> element -> acc) -> acc -> acc
foldLeft iterator folder accumulator =
    case next iterator of
        Some value -> foldLeft iterator folder (folder accumulator value)
        None -> accumulator
    end
GENFN_END
GENFN_DEP yona_Std_Iterator__next nextNative FN yona_Std_Iterator__nextNative 1 ADT(Iterator,VAR(element)) -> ADT(Option,VAR(element)) retadt Option
