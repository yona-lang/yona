MODULE Std\Json
ADT Json 7 1 recursive
  CTOR JsonNull 0 0
  CTOR JsonBool 1 1 fields _0:BOOL
  CTOR JsonInt 2 1 fields _0:INT
  CTOR JsonFloat 3 1 fields _0:FLOAT
  CTOR JsonString 4 1 fields _0:STRING
  CTOR JsonArray 5 1 fields _0:SEQ
  CTOR JsonObject 6 1 fields _0:SEQ
FN null 0 -> STRING
FN parse 1 STRING -> ADT(Result)
FN parseFloat 1 STRING -> FLOAT
FN parseInt 1 STRING -> INT
FN stringify 1 ADT -> STRING
FN stringifyBool 1 BOOL -> STRING
FN stringifyFloat 1 FLOAT -> STRING
FN stringifyString 1 STRING -> STRING
GENFN_BEGIN asInt asInt
asInt j =
    case j of
        JsonInt n -> Some n
        _ -> None
    end
GENFN_END
GENFN_BEGIN asString asString
asString j =
    case j of
        JsonString s -> Some s
        _ -> None
    end
GENFN_END
GENFN_BEGIN get get
get j key =
    case j of
        JsonObject pairs -> getPair pairs key
        _ -> None
    end
GENFN_END
GENFN_BEGIN getPair getPair
getPair pairs key =
    getPairAt pairs key 0 (length pairs)
GENFN_END
GENFN_BEGIN getPairAt getPairAt
getPairAt pairs key i n =
    if i >= n then None
    else
        case get pairs i of
            (k, v) -> if k == key then Some v else getPairAt pairs key (i + 1) n
        end
GENFN_END
