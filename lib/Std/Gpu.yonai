GENFN_CTOR mapGpu Add IntMapOp 0 1 3 1 fields _0:INT
GENFN_CTOR mapGpu Buffer Buffer 0 1 1 1 fields _0:ADT(IntArray)
GENFN_CTOR mapGpu Mul IntMapOp 1 1 3 1 fields _0:INT
GENFN_CTOR mapGpu Square IntMapOp 2 0 3 1
GENFN_BEGIN mapGpu mapGpu
mapGpu : IntMapOp -> Buffer -> Buffer
mapGpu op buffer =
    case op of
        Add d -> mapAdd d buffer
        Mul f -> mapMul f buffer
        Square -> mapSquare buffer
    end
GENFN_END
