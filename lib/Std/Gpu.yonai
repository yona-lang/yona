GENFN_CTOR checkGpu Ok Result 0 1 2 1 fields _0:VAR(a)
GENFN_CTOR checkGpu Err Result 1 1 2 1 fields _0:VAR(e)
GENFN_CTOR checkGpu GpuOom GpuIssue 1 0 4 1
GENFN_CTOR checkGpu GpuDeviceLost GpuIssue 2 0 4 1
GENFN_CTOR checkGpu GpuOther GpuIssue 3 1 4 1 fields _0:INT
GENFN_BEGIN checkGpu checkGpu
checkGpu =
    case vulkanLastIssueKind of
        0 -> Ok 0
        1 -> Err GpuOom
        2 -> Err GpuDeviceLost
        code -> Err (GpuOther code)
    end
GENFN_END
