GENFN_CTOR drainMapFloatGpu Some Option 0 1 2 1 fields _0:VAR(a)
GENFN_CTOR drainMapFloatGpu None Option 1 0 2 1
GENFN_BEGIN drainMapFloatGpu drainMapFloatGpu
drainMapFloatGpu op rx tx =
    import send, recv from Std\Channel in
    case recv rx of
        None -> 0
        Some chunk ->
            let mapped = mapFloatGpu op chunk in
            let _ = send tx mapped in
            1 + drainMapFloatGpu op rx tx
    end
GENFN_END
GENFN_CTOR encodeIntMapStages Add IntMapOp 0 1 3 1 fields _0:INT
GENFN_CTOR encodeIntMapStages Mul IntMapOp 1 1 3 1 fields _0:INT
GENFN_CTOR encodeIntMapStages Square IntMapOp 2 0 3 1
GENFN_BEGIN encodeIntMapStages encodeIntMapStages
encodeIntMapStages stages =
    import fromSeq from Std\IntArray in
    import foldr from Std\List in
    fromSeq (foldr (\op acc ->
        case op of
            Add d -> 0 :: (d :: acc)
            Mul f -> 1 :: (f :: acc)
            Square -> 2 :: (0 :: acc)
        end) [] stages)
GENFN_END
