GENFN_CTOR raiseGpu GpuOk GpuIssue 0 0 4 1
GENFN_CTOR raiseGpu GpuOom GpuIssue 1 0 4 1
GENFN_CTOR raiseGpu GpuDeviceLost GpuIssue 2 0 4 1
GENFN_CTOR raiseGpu GpuOther GpuIssue 3 1 4 1 fields _0:INT
GENFN_BEGIN raiseGpu raiseGpu
raiseGpu issue =
    case issue of
        GpuOk -> ()
        GpuOom -> perform Gpu.oom ()
        GpuDeviceLost -> perform Gpu.deviceLost ()
        GpuOther code -> perform Gpu.fail code
    end
GENFN_END
