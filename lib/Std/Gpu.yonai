GENFN_BEGIN withGpuFallback withGpuFallback
withGpuFallback action =
    let result = action () in
    let _ = raiseGpu gpuLastIssue in
    result
GENFN_END
GENFN_CTOR withGpuIssue GpuOom GpuIssue 1 0 4 1
GENFN_CTOR withGpuIssue GpuDeviceLost GpuIssue 2 0 4 1
GENFN_CTOR withGpuIssue GpuOther GpuIssue 3 1 4 1 fields _0:INT
GENFN_BEGIN withGpuIssue withGpuIssue
withGpuIssue onOk onIssue =
    case vulkanLastIssueKind of
        0 -> onOk ()
        1 -> onIssue GpuOom
        2 -> onIssue GpuDeviceLost
        code -> onIssue (GpuOther code)
    end
GENFN_END
