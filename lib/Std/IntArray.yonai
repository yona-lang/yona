MODULE Std\IntArray
FN alloc 1 INT -> INT_ARRAY
FN cons 2 INT INT_ARRAY -> INT_ARRAY
FN fill 2 INT INT -> INT_ARRAY
FN filter 2 FUNCTION INT_ARRAY -> INT_ARRAY
FN foldl 3 FUNCTION INT INT_ARRAY -> INT
FN fromSeq 1 SEQ -> INT_ARRAY
FN get 2 INT_ARRAY INT -> INT
FN head 1 INT_ARRAY -> INT
FN join 2 INT_ARRAY INT_ARRAY -> INT_ARRAY
FN length 1 INT_ARRAY -> INT
FN map 2 FUNCTION INT_ARRAY -> INT_ARRAY
FN set 3 INT_ARRAY INT INT -> INT_ARRAY
FN slice 3 INT_ARRAY INT INT -> INT_ARRAY
FN tail 1 INT_ARRAY -> INT_ARRAY
FN toSeq 1 INT_ARRAY -> SEQ
