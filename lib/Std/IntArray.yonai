MODULE Std\IntArray
FN alloc 1 INT -> INT_ARRAY
FN cons 2 INT INT_ARRAY -> INT_ARRAY borrow 01
FN fill 2 INT INT -> INT_ARRAY
FN filter 2 FUNCTION INT_ARRAY -> INT_ARRAY borrow 11
FN foldl 3 FUNCTION INT INT_ARRAY -> INT borrow 101
FN fromSeq 1 SEQ -> INT_ARRAY borrow 1
FN get 2 INT_ARRAY INT -> INT borrow 10
FN head 1 INT_ARRAY -> INT borrow 1
FN join 2 INT_ARRAY INT_ARRAY -> INT_ARRAY borrow 11
FN length 1 INT_ARRAY -> INT borrow 1
FN map 2 FUNCTION INT_ARRAY -> INT_ARRAY borrow 11
FN set 3 INT_ARRAY INT INT -> INT_ARRAY borrow 100
FN slice 3 INT_ARRAY INT INT -> INT_ARRAY borrow 100
FN tail 1 INT_ARRAY -> INT_ARRAY borrow 1
FN toSeq 1 INT_ARRAY -> SEQ borrow 1
