GENFN_BEGIN yona_Std_Result__flatten flatten
flatten : Result (Result (a, e), e) -> Result (a, e)
flatten r =
    case r of
        Ok inner -> case inner of
            Ok v  -> Ok v
            Err e -> Err e
        end
        Err e -> Err e
    end
