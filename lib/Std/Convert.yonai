MODULE Std\Convert
INSTANCE From ByteArray String
  IMPL convert Std\Convert From_ByteArray_String_convert
INSTANCE From String Bool
  IMPL convert Std\Convert From_String_Bool_convert
INSTANCE From String Float
  IMPL convert Std\Convert From_String_Float_convert
INSTANCE From String Int
  IMPL convert Std\Convert From_String_Int_convert
INSTANCE Parse Bool
  IMPL parse Std\Convert Parse_Bool_parse
INSTANCE Parse Float
  IMPL parse Std\Convert Parse_Float_parse
INSTANCE Parse Int
  IMPL parse Std\Convert Parse_Int_parse
INSTANCE Parse String
  IMPL parse Std\Convert Parse_String_parse
INSTANCE TryFrom Float Int
  IMPL tryConvert Std\Convert TryFrom_Float_Int_tryConvert
INSTANCE TryFrom Int Float
  IMPL tryConvert Std\Convert TryFrom_Int_Float_tryConvert
INSTANCE TryFrom String ByteArray
  IMPL tryConvert Std\Convert TryFrom_String_ByteArray_tryConvert
FN From_ByteArray_String_convert 2 BYTE_ARRAY STRING -> BYTE_ARRAY borrow 10
FN From_String_Bool_convert 2 STRING BOOL -> STRING borrow 10
FN From_String_Float_convert 2 STRING FLOAT -> STRING borrow 10
FN From_String_Int_convert 2 STRING INT -> STRING borrow 10
FN Parse_Bool_parse 2 BOOL STRING -> ADT(Result,BOOL,ADT(ParseError)) borrow 10
FN Parse_Float_parse 2 FLOAT STRING -> ADT(Result,FLOAT,ADT(ParseError)) borrow 10
FN Parse_Int_parse 2 INT STRING -> ADT(Result,INT,ADT(ParseError)) borrow 10
FN Parse_String_parse 2 STRING STRING -> ADT(Result,STRING,ADT(ParseError)) borrow 10
FN TryFrom_Float_Int_tryConvert 2 FLOAT INT -> ADT(Result,FLOAT,ADT(ConvertError)) borrow 10
FN TryFrom_Int_Float_tryConvert 2 INT FLOAT -> ADT(Result,INT,ADT(ConvertError)) borrow 10
FN TryFrom_String_ByteArray_tryConvert 2 STRING BYTE_ARRAY -> ADT(Result,STRING,ADT(ConvertError)) borrow 10
FN decodeUtf8 1 BYTE_ARRAY -> ADT(Result,STRING,ADT(ConvertError)) effects -
FN encodeUtf8 1 STRING -> BYTE_ARRAY effects -
FN floatToInt 1 FLOAT -> ADT(Result,INT,ADT(ConvertError)) effects -
FN formatBool 1 BOOL -> STRING effects -
FN formatFloat 1 FLOAT -> STRING effects -
FN formatInt 1 INT -> STRING effects -
FN intToFloat 1 INT -> ADT(Result,FLOAT,ADT(ConvertError)) effects -
FN parseBool 1 STRING -> ADT(Result,BOOL,ADT(ParseError)) effects -
FN parseFloat 1 STRING -> ADT(Result,FLOAT,ADT(ParseError)) effects -
FN parseInt 1 STRING -> ADT(Result,INT,ADT(ParseError)) effects -
FN parseString 1 STRING -> ADT(Result,STRING,ADT(ParseError)) effects -
GENFN_BEGIN From_ByteArray_String_convert convert
convert : ByteArray -> String -> ByteArray
    convert _ value = import fromString from Std\ByteArray in fromString value
GENFN_END
GENFN_BEGIN From_String_Bool_convert convert
convert : String -> Bool -> String
    convert _ value = import boolToString from Std\Types in boolToString value
GENFN_END
GENFN_BEGIN From_String_Float_convert convert
convert : String -> Float -> String
    convert _ value = import floatToString from Std\Types in floatToString value
GENFN_END
GENFN_BEGIN From_String_Int_convert convert
convert : String -> Int -> String
    convert _ value = import intToString from Std\Types in intToString value
GENFN_END
GENFN_CTOR Parse_Bool_parse InvalidSyntax ParseError 0 1 2 1 fields _0:STRING
GENFN_CTOR Parse_Bool_parse Ok Result 0 1 2 1 fields _0:VAR(a)
GENFN_CTOR Parse_Bool_parse Err Result 1 1 2 1 fields _0:VAR(e)
GENFN_BEGIN Parse_Bool_parse parse
parse : Bool -> String -> Result (Bool, ParseError)
    parse _ text = if text == "true" then Ok true
        else if text == "false" then Ok false
        else Err (InvalidSyntax ("expected 'true' or 'false', found '" ++ text ++ "'"))
GENFN_END
GENFN_DEP Parse_Float_parse parseFloatNative NATIVE YonaStdConvertParseFloatNative FN 1 STRING -> ADT(Result,FLOAT,ADT(ParseError))
GENFN_BEGIN Parse_Float_parse parse
parse : Float -> String -> Result (Float, ParseError)
    parse _ text = parseFloatNative text
GENFN_END
GENFN_DEP Parse_Int_parse parseIntNative NATIVE YonaStdConvertParseIntNative FN 1 STRING -> ADT(Result,INT,ADT(ParseError))
GENFN_BEGIN Parse_Int_parse parse
parse : Int -> String -> Result (Int, ParseError)
    parse _ text = parseIntNative text
GENFN_END
GENFN_CTOR Parse_String_parse Ok Result 0 1 2 1 fields _0:VAR(a)
GENFN_BEGIN Parse_String_parse parse
parse : String -> String -> Result (String, ParseError)
    parse _ text = Ok text
GENFN_END
GENFN_DEP TryFrom_Float_Int_tryConvert intToFloatNative NATIVE YonaStdConvertIntToFloatNative FN 1 INT -> ADT(Result,FLOAT,ADT(ConvertError))
GENFN_BEGIN TryFrom_Float_Int_tryConvert tryConvert
tryConvert : Float -> Int -> Result (Float, ConvertError)
    tryConvert _ value = intToFloatNative value
GENFN_END
GENFN_DEP TryFrom_Int_Float_tryConvert floatToIntNative NATIVE YonaStdConvertFloatToIntNative FN 1 FLOAT -> ADT(Result,INT,ADT(ConvertError))
GENFN_BEGIN TryFrom_Int_Float_tryConvert tryConvert
tryConvert : Int -> Float -> Result (Int, ConvertError)
    tryConvert _ value = floatToIntNative value
GENFN_END
GENFN_DEP TryFrom_String_ByteArray_tryConvert decodeUtf8Native NATIVE YonaStdConvertDecodeUtf8Native FN 1 BYTE_ARRAY -> ADT(Result,STRING,ADT(ConvertError))
GENFN_BEGIN TryFrom_String_ByteArray_tryConvert tryConvert
tryConvert : String -> ByteArray -> Result (String, ConvertError)
    tryConvert _ value = decodeUtf8Native value
GENFN_END
GENFN_BEGIN byteArrayTarget byteArrayTarget
byteArrayTarget : Unit -> ByteArray
byteArrayTarget _ = import alloc from Std\ByteArray in alloc 0
GENFN_END
GENFN_BEGIN decodeUtf8 decodeUtf8
decodeUtf8 : ByteArray -> Result (String, ConvertError)
decodeUtf8 bytes = tryConvert "" bytes
GENFN_END
GENFN_BEGIN encodeUtf8 encodeUtf8
encodeUtf8 : String -> ByteArray
encodeUtf8 text = convert (byteArrayTarget ()) text
GENFN_END
GENFN_BEGIN floatToInt floatToInt
floatToInt : Float -> Result (Int, ConvertError)
floatToInt value = tryConvert 0 value
GENFN_END
GENFN_BEGIN formatBool formatBool
formatBool : Bool -> String
formatBool value = convert "" value
GENFN_END
GENFN_BEGIN formatFloat formatFloat
formatFloat : Float -> String
formatFloat value = convert "" value
GENFN_END
GENFN_BEGIN formatInt formatInt
formatInt : Int -> String
formatInt value = convert "" value
GENFN_END
GENFN_BEGIN intToFloat intToFloat
intToFloat : Int -> Result (Float, ConvertError)
intToFloat value = tryConvert 0.0 value
GENFN_END
GENFN_BEGIN parseBool parseBool
parseBool : String -> Result (Bool, ParseError)
parseBool text = parse false text
GENFN_END
GENFN_BEGIN parseFloat parseFloat
parseFloat : String -> Result (Float, ParseError)
parseFloat text = parse 0.0 text
GENFN_END
GENFN_BEGIN parseInt parseInt
parseInt : String -> Result (Int, ParseError)
parseInt text = parse 0 text
GENFN_END
GENFN_BEGIN parseString parseString
parseString : String -> Result (String, ParseError)
parseString text = parse "" text
GENFN_END
