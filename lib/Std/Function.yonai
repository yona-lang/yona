FN yona_Std_Function__apply 2 INT FUNCTION -> INT borrow 01 effects |
FN yona_Std_Function__compose 3 FUNCTION FUNCTION INT -> INT borrow 110 effects | hof
FN yona_Std_Function__const 2 INT INT -> INT effects -
FN yona_Std_Function__fix 2 FUNCTION INT -> INT effects | hof
FN yona_Std_Function__flip 3 FUNCTION INT INT -> INT borrow 100 effects | hof
FN yona_Std_Function__identity 1 INT -> INT effects -
FN yona_Std_Function__on 4 FUNCTION FUNCTION INT INT -> INT borrow 1100 effects | hof
FN yona_Std_Function__pipe 2 INT SEQ -> INT effects |
GENFN_BEGIN yona_Std_Function__apply apply
apply x f = f x
GENFN_END
GENFN_BEGIN yona_Std_Function__compose compose
compose f g x = f (g x)
GENFN_END
GENFN_BEGIN yona_Std_Function__const const
const value _ = value
GENFN_END
GENFN_BEGIN yona_Std_Function__fix fix
fix f value =
    let loop value = f loop value
    in loop value
GENFN_END
GENFN_BEGIN yona_Std_Function__flip flip
flip f a b = f b a
GENFN_END
GENFN_BEGIN yona_Std_Function__identity identity
identity x = x
GENFN_END
GENFN_BEGIN yona_Std_Function__on on
on cmp f a b = cmp (f a) (f b)
GENFN_END
GENFN_BEGIN yona_Std_Function__pipe pipe
pipe x fns =
    case fns of
        [] -> x
        [f|rest] -> pipe (f x) rest
    end
GENFN_END
