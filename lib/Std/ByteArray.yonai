MODULE Std\ByteArray
FN alloc 1 INT -> BYTE_ARRAY
FN concat 2 BYTE_ARRAY BYTE_ARRAY -> BYTE_ARRAY borrow 11
FN foldl 3 FUNCTION INT BYTE_ARRAY -> INT borrow 101
FN fromSeq 1 SEQ -> BYTE_ARRAY borrow 1
FN fromString 1 STRING -> BYTE_ARRAY borrow 1
FN get 2 BYTE_ARRAY INT -> INT borrow 10
FN head 1 BYTE_ARRAY -> INT borrow 1
FN join 2 BYTE_ARRAY BYTE_ARRAY -> BYTE_ARRAY borrow 11
FN length 1 BYTE_ARRAY -> INT borrow 1
FN map 2 FUNCTION BYTE_ARRAY -> BYTE_ARRAY borrow 11
FN set 3 BYTE_ARRAY INT INT -> UNIT borrow 100
FN slice 3 BYTE_ARRAY INT INT -> BYTE_ARRAY borrow 100
FN tail 1 BYTE_ARRAY -> BYTE_ARRAY borrow 1
FN toSeq 1 BYTE_ARRAY -> SEQ borrow 1
FN toString 1 BYTE_ARRAY -> STRING borrow 1
