MODULE Std\FloatArray
FN alloc 1 INT -> FLOAT_ARRAY
FN cons 2 FLOAT FLOAT_ARRAY -> FLOAT_ARRAY borrow 01
FN fill 2 INT FLOAT -> FLOAT_ARRAY
FN foldl 3 FUNCTION FLOAT FLOAT_ARRAY -> FLOAT borrow 101
FN get 2 FLOAT_ARRAY INT -> FLOAT borrow 10
FN head 1 FLOAT_ARRAY -> FLOAT borrow 1
FN join 2 FLOAT_ARRAY FLOAT_ARRAY -> FLOAT_ARRAY borrow 11
FN length 1 FLOAT_ARRAY -> INT borrow 1
FN map 2 FUNCTION FLOAT_ARRAY -> FLOAT_ARRAY borrow 11
FN set 3 FLOAT_ARRAY INT FLOAT -> FLOAT_ARRAY borrow 100
FN tail 1 FLOAT_ARRAY -> FLOAT_ARRAY borrow 1
