MODULE Std\FloatArray
FN alloc 1 INT -> FLOAT_ARRAY
FN cons 2 FLOAT FLOAT_ARRAY -> FLOAT_ARRAY
FN fill 2 INT FLOAT -> FLOAT_ARRAY
FN foldl 3 FUNCTION FLOAT FLOAT_ARRAY -> FLOAT
FN get 2 FLOAT_ARRAY INT -> FLOAT
FN head 1 FLOAT_ARRAY -> FLOAT
FN join 2 FLOAT_ARRAY FLOAT_ARRAY -> FLOAT_ARRAY
FN length 1 FLOAT_ARRAY -> INT
FN map 2 FUNCTION FLOAT_ARRAY -> FLOAT_ARRAY
FN set 3 FLOAT_ARRAY INT FLOAT -> FLOAT_ARRAY
FN tail 1 FLOAT_ARRAY -> FLOAT_ARRAY
