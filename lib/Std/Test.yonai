GENFN_CTOR yona_Std_Test__runCases TestReport TestReport 0 3 1 3 fieldname:passed field:INT shape:INT fieldname:failed field:INT shape:INT fieldname:lines field:SEQ shape:SEQ
GENFN_CTOR yona_Std_Test__runCases Pass TestResult 0 1 2 1 field:STRING shape:STRING
GENFN_CTOR yona_Std_Test__runCases Fail TestResult 1 1 2 1 field:STRING shape:STRING
GENFN_CTOR yona_Std_Test__runCases TestCase TestCase 0 2 1 2 recursive fieldname:name field:STRING shape:STRING fieldname:thunk field:FUNCTION:ADT:TestResult shape:Fn(ADT(TestResult))
GENFN_BEGIN yona_Std_Test__runCases runCases
runCases : Seq TestCase -> Int -> Int -> Seq String -> TestReport
runCases cases passed failed lines =
    import reverse from Std\List in
    case cases of
        [] -> TestReport { passed = passed, failed = failed, lines = reverse lines }
        [TestCase { name = name, thunk = thunk } | rest] ->
            case thunk () of
                Pass _ -> runCases rest (passed + 1) failed (("PASS " ++ name) :: lines)
                Fail message ->
                    let reportLine = "FAIL " ++ name ++ ": " ++ message in
                    runCases rest passed (failed + 1) (reportLine :: lines)
            end
    end
GENFN_END
GENFN_CTOR yona_Std_Test__render TestReport TestReport 0 3 1 3 fieldname:passed field:INT shape:INT fieldname:failed field:INT shape:INT fieldname:lines field:SEQ shape:SEQ
GENFN_BEGIN yona_Std_Test__render render
render : TestReport -> String
render report =
    import join from Std\String, intToString from Std\Types in
    case report of
        TestReport { passed = passedCount, failed = failedCount, lines = reportLines } ->
            let summary = "SUMMARY " ++ intToString passedCount ++ " passed, " ++
                    intToString failedCount ++ " failed" in
            case reportLines of
                [] -> summary
                _ -> join "\n" reportLines ++ "\n" ++ summary
            end
    end
GENFN_END
GENFN_CTOR yona_Std_Test__run TestReport TestReport 0 3 1 3 fieldname:passed field:INT shape:INT fieldname:failed field:INT shape:INT fieldname:lines field:SEQ shape:SEQ
GENFN_CTOR yona_Std_Test__run TestCase TestCase 0 2 1 2 recursive fieldname:name field:STRING shape:STRING fieldname:thunk field:FUNCTION:ADT:TestResult shape:Fn(ADT(TestResult))
GENFN_BEGIN yona_Std_Test__run run
run : Seq TestCase -> TestReport
run cases = runCases cases 0 0 []
GENFN_END
GENFN_CTOR yona_Std_Test__testCase TestCase TestCase 0 2 1 2 recursive fieldname:name field:STRING shape:STRING fieldname:thunk field:FUNCTION:ADT:TestResult shape:Fn(ADT(TestResult))
GENFN_BEGIN yona_Std_Test__testCase testCase
testCase : String -> (() -> TestResult) -> TestCase
testCase name thunk = TestCase { name = name, thunk = thunk }
GENFN_END
GENFN_CTOR yona_Std_Test__check Pass TestResult 0 1 2 1 field:STRING shape:STRING
GENFN_CTOR yona_Std_Test__check Fail TestResult 1 1 2 1 field:STRING shape:STRING
GENFN_BEGIN yona_Std_Test__check check
check : String -> Bool -> TestResult
check message condition =
    if condition then Pass message else Fail message
GENFN_END
GENFN_CTOR yona_Std_Test__equalBy Pass TestResult 0 1 2 1 field:STRING shape:STRING
GENFN_CTOR yona_Std_Test__equalBy Fail TestResult 1 1 2 1 field:STRING shape:STRING
GENFN_BEGIN yona_Std_Test__equalBy equalBy
equalBy : String -> (a -> a -> Bool) -> a -> a -> TestResult
equalBy message equals expected actual =
    if equals expected actual then Pass message else Fail message
GENFN_END
GENFN_CTOR yona_Std_Test__fail Pass TestResult 0 1 2 1 field:STRING shape:STRING
GENFN_CTOR yona_Std_Test__fail Fail TestResult 1 1 2 1 field:STRING shape:STRING
GENFN_BEGIN yona_Std_Test__fail fail
fail : String -> TestResult
fail message = Fail message
GENFN_END
GENFN_CTOR yona_Std_Test__pass Pass TestResult 0 1 2 1 field:STRING shape:STRING
GENFN_BEGIN yona_Std_Test__pass pass
pass : String -> TestResult
pass message = Pass message
GENFN_END
