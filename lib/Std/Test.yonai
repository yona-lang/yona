MODULE Std\Test
ADT TestCase 1 2 recursive
  CTOR TestCase 0 2 fields name:STRING thunk:FUNCTION(UNIT,ADT(TestResult))
ADT TestReport 1 3
  CTOR TestReport 0 3 fields passed:INT failed:INT lines:Seq(STRING)
ADT TestResult 2 1
  CTOR Pass 0 1 fields _0:STRING
  CTOR Fail 1 1 fields _0:STRING
FN check 2 STRING BOOL -> ADT(TestResult) borrow 01 effects - effectscheme $##;$/r##
FN equalBy 4 STRING FUNCTION(VAR(a),FUNCTION(VAR(a),BOOL)) VAR(a) VAR(a) -> ADT(TestResult) borrow 0100 effects - effectscheme $##;$/r##;$/r/p##;$/r/p/r##;$/r/r##;$/r/r/r##
FN fail 1 STRING -> ADT(TestResult) effects - effectscheme $##
FN pass 1 STRING -> ADT(TestResult) effects - effectscheme $##
FN render 1 ADT(TestReport) -> STRING effects - effectscheme $##
FN run 1 Seq(ADT(TestCase)) -> ADT(TestReport) effects | effectscheme $##o0|f1
FN testCase 2 STRING FUNCTION(UNIT,ADT(TestResult)) -> ADT(TestCase) effects - effectscheme $##;$/r##;$/r/p##
GENFN_CTOR check Pass TestResult 0 1 2 1 fields _0:STRING
GENFN_CTOR check Fail TestResult 1 1 2 1 fields _0:STRING
GENFN_BEGIN check check
check : String -> Bool -> TestResult
check message condition =
    if condition then Pass message else Fail message
GENFN_END
GENFN_CTOR equalBy Pass TestResult 0 1 2 1 fields _0:STRING
GENFN_CTOR equalBy Fail TestResult 1 1 2 1 fields _0:STRING
GENFN_BEGIN equalBy equalBy
equalBy : String -> (a -> a -> Bool) -> a -> a -> TestResult
equalBy message equals expected actual =
    if equals expected actual then Pass message else Fail message
GENFN_END
GENFN_CTOR fail Pass TestResult 0 1 2 1 fields _0:STRING
GENFN_CTOR fail Fail TestResult 1 1 2 1 fields _0:STRING
GENFN_BEGIN fail fail
fail : String -> TestResult
fail message = Fail message
GENFN_END
GENFN_CTOR pass Pass TestResult 0 1 2 1 fields _0:STRING
GENFN_BEGIN pass pass
pass : String -> TestResult
pass message = Pass message
GENFN_END
GENFN_CTOR render TestReport TestReport 0 3 1 3 fields passed:INT failed:INT lines:Seq(STRING)
GENFN_BEGIN render render
render : TestReport -> String
render report =
    import join from Std\String, intToString from Std\Types in
    case report of
        TestReport { passed = passedCount, failed = failedCount, lines = reportLines } ->
            let summary = "SUMMARY " ++ intToString passedCount ++ " passed, " ++
                    intToString failedCount ++ " failed" in
            case reportLines of
                [] -> summary
                _ -> join "\n" reportLines ++ "\n" ++ summary
            end
    end
GENFN_END
GENFN_CTOR run TestCase TestCase 0 2 1 2 recursive fields name:STRING thunk:FUNCTION(UNIT,ADT(TestResult))
GENFN_CTOR run TestReport TestReport 0 3 1 3 fields passed:INT failed:INT lines:Seq(STRING)
GENFN_BEGIN run run
run : Seq TestCase -> TestReport
run cases = runCases cases 0 0 []
GENFN_END
GENFN_CTOR runCases Pass TestResult 0 1 2 1 fields _0:STRING
GENFN_CTOR runCases TestCase TestCase 0 2 1 2 recursive fields name:STRING thunk:FUNCTION(UNIT,ADT(TestResult))
GENFN_CTOR runCases TestReport TestReport 0 3 1 3 fields passed:INT failed:INT lines:Seq(STRING)
GENFN_CTOR runCases Fail TestResult 1 1 2 1 fields _0:STRING
GENFN_BEGIN runCases runCases
runCases : Seq TestCase -> Int -> Int -> Seq String -> TestReport
runCases cases passed failed lines =
    import reverse from Std\List in
    case cases of
        [] -> TestReport { passed = passed, failed = failed, lines = reverse lines }
        [TestCase { name = name, thunk = thunk } | rest] ->
            case thunk () of
                Pass _ -> runCases rest (passed + 1) failed (("PASS " ++ name) :: lines)
                Fail message ->
                    let reportLine = "FAIL " ++ name ++ ": " ++ message in
                    runCases rest passed (failed + 1) (reportLine :: lines)
            end
    end
GENFN_END
GENFN_CTOR testCase TestCase TestCase 0 2 1 2 recursive fields name:STRING thunk:FUNCTION(UNIT,ADT(TestResult))
GENFN_BEGIN testCase testCase
testCase : String -> (() -> TestResult) -> TestCase
testCase name thunk = TestCase { name = name, thunk = thunk }
GENFN_END
