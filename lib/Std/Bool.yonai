MODULE Std\Bool
FN and 2 INT INT -> INT
FN implies 2 INT INT -> INT
FN not 1 INT -> BOOL
FN or 2 INT INT -> BOOL
FN unless 2 INT FUNCTION -> SYMBOL borrow 01
FN when 2 INT FUNCTION -> INT borrow 01
FN xor 2 INT INT -> BOOL
GENFN_BEGIN and and
and a b = if a then b else false
GENFN_END
GENFN_BEGIN implies implies
implies a b = if a then b else true
GENFN_END
GENFN_BEGIN not not
not x = if x then false else true
GENFN_END
GENFN_BEGIN or or
or a b = if a then true else b
GENFN_END
GENFN_BEGIN unless unless
unless cond fn = if cond then :ok else fn ()
GENFN_END
GENFN_BEGIN when when
when cond fn = if cond then fn () else :ok
GENFN_END
GENFN_BEGIN xor xor
xor a b = if a then not b else b
GENFN_END
