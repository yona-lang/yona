MODULE Std\Bool
FN and 2 BOOL BOOL -> BOOL borrow 10 effects - effectscheme $##;$/r##
FN implies 2 BOOL BOOL -> BOOL borrow 10 effects - effectscheme $##;$/r##
FN not 1 BOOL -> BOOL borrow 1 effects - effectscheme $##
FN or 2 BOOL BOOL -> BOOL borrow 10 effects - effectscheme $##;$/r##
FN unless 2 BOOL FUNCTION(UNIT,SYMBOL) -> SYMBOL borrow 11 effects | effectscheme $##;$/r##f0;$/r/p##f0
FN when 2 BOOL FUNCTION(UNIT,SYMBOL) -> SYMBOL borrow 11 effects | effectscheme $##;$/r##f0;$/r/p##f0
FN xor 2 BOOL BOOL -> BOOL borrow 10 effects - effectscheme $##;$/r##
GENFN_BEGIN and and
and a b = if a then b else false
GENFN_END
GENFN_BEGIN implies implies
implies a b = if a then b else true
GENFN_END
GENFN_BEGIN not not
not x = if x then false else true
GENFN_END
GENFN_BEGIN or or
or a b = if a then true else b
GENFN_END
GENFN_BEGIN unless unless
unless cond fn = if cond then :ok else fn ()
GENFN_END
GENFN_BEGIN when when
when cond fn = if cond then fn () else :ok
GENFN_END
GENFN_BEGIN xor xor
xor a b = if a then not b else b
GENFN_END
