MODULE Std\File
FN appendFile 2 STRING STRING -> BOOL borrow 11
FN closeFileHandle 1 ADT(FileHandle) -> UNIT
FN exists 1 STRING -> BOOL borrow 1
FN flush 1 ADT(FileHandle) -> BOOL borrow 1
FN listDir 1 STRING -> Seq(STRING) borrow 1
FN openFile 2 STRING ADT(FileMode) -> LINEAR(ADT(FileHandle)) borrow 11
IO readBytes 2 ADT(FileHandle) INT -> BYTE_ARRAY borrow 10
FN readChunks 2 ADT(FileHandle) INT -> ADT(Iterator,BYTE_ARRAY) borrow 10
FN readExact 2 ADT(FileHandle) INT -> ADT(Result,STRING,STRING) borrow 10
FN readExactBytes 2 ADT(FileHandle) INT -> STRING borrow 10
IO readFile 1 STRING -> STRING borrow 1
IO readFileBytes 1 STRING -> BYTE_ARRAY borrow 1
FN readLines 1 STRING -> ADT(Iterator,STRING) borrow 1
FN remove 1 STRING -> BOOL borrow 1
FN seek 3 ADT(FileHandle) INT ADT(Whence) -> INT borrow 101
FN size 1 STRING -> INT borrow 1
FN tell 1 ADT(FileHandle) -> INT borrow 1
FN truncate 2 ADT(FileHandle) INT -> BOOL borrow 10
IO writeBytes 2 ADT(FileHandle) BYTE_ARRAY -> INT borrow 11
IO writeFile 2 STRING STRING -> BOOL borrow 11
FN writeFileBytes 2 STRING BYTE_ARRAY -> BOOL borrow 11
