## Recursive JSON values — object/array parse and stringify.
##
## `parse` returns `Result Json String`. `stringify` emits compact JSON.
## `get` / `asString` / `asInt` work from expression programs (imported
## constructors can be pattern-matched). Scalar helpers
## (`stringifyString`, `parseInt`, …) stay available for fragments.
## `yls-yona` uses `parse` / `stringify` / `get` for JSON-RPC bodies.
##
## Parse and stringify run in the C runtime (recursive ADT walk).
module Std\Json

export type Json
export parse, stringify, get, asString, asInt
export stringifyString, stringifyBool, stringifyFloat, null, parseInt, parseFloat

## JSON value: null, bool, int, float, string, array, or object.
## Objects preserve member order as a sequence of `(key, value)` pairs.
type Json =
    JsonNull
  | JsonBool Bool
  | JsonInt Int
  | JsonFloat Float
  | JsonString String
  | JsonArray (Seq Json)
  | JsonObject (Seq (String, Json))

## Parse one JSON value. Trailing non-whitespace is an error.
##
## ```
## parse "{\"id\":1}"   # => Ok (JsonObject [("id", JsonInt 1)])
## ```
extern parse : String -> Result (Json, String) = "YonaStdJsonParse" borrow "1"

## Compact JSON text for `j`.
##
## ```
## stringify (JsonInt 1)   # => "1"
## ```
extern stringify : Json -> String = "YonaStdJsonStringify" borrow "1"

extern stringifyString : String -> String = "YonaStdJsonStringifyString" borrow "1"
extern stringifyBool : Bool -> String = "YonaStdJsonStringifyBool"
extern stringifyFloat : Float -> String = "YonaStdJsonStringifyFloat"
extern null : String = "YonaStdJsonNull"
extern parseInt : String -> Int = "YonaStdJsonParseInt" borrow "1"
extern parseFloat : String -> Float = "YonaStdJsonParseFloat" borrow "1"

## Look up `key` in a JSON object. `None` if `j` is not an object or the key is missing.
get : Json -> String -> Option Json
get j key =
    case j of
        JsonObject pairs -> getPair pairs key
        _ -> None
    end

getPair : Seq (String, Json) -> String -> Option Json
getPair pairs key =
    case pairs of
        [] -> None
        [(k, v) | rest] -> if k == key then Some v else getPair rest key
    end

## Unwrap a JSON string.
asString : Json -> Option String
asString j =
    case j of
        JsonString s -> Some s
        _ -> None
    end

## Unwrap a JSON integer.
asInt : Json -> Option Int
asInt j =
    case j of
        JsonInt n -> Some n
        _ -> None
    end
