GENFN_BEGIN yona_Prelude__compose compose
compose f g x = f (g x)
GENFN_END
GENFN_BEGIN yona_Prelude__const const
const x _ = x
GENFN_END
GENFN_BEGIN yona_Prelude__dictEntriesAllPresentAt dictEntriesAllPresentAt
dictEntriesAllPresentAt : (key -> key -> Bool) -> (value -> value -> Bool) ->
    Seq (key, value) -> Seq (key, value) -> Int -> Int -> Int -> Bool
dictEntriesAllPresentAt @borrow keyEquals @borrow valueEquals @borrow values @borrow candidates index valueCount candidateCount =
    if index >= valueCount then true
    else let wanted = get values index in
    case wanted of (wantedKey, wantedValue) ->
        if dictEntryPresentAt keyEquals valueEquals candidates wantedKey wantedValue 0 candidateCount then
            dictEntriesAllPresentAt keyEquals valueEquals values candidates (index + 1) valueCount candidateCount
        else false
    end
GENFN_END
GENFN_BEGIN yona_Prelude__dictEntryPresentAt dictEntryPresentAt
dictEntryPresentAt : (key -> key -> Bool) -> (value -> value -> Bool) ->
    Seq (key, value) -> key -> value -> Int -> Int -> Bool
dictEntryPresentAt @borrow keyEquals @borrow valueEquals @borrow candidates @borrow wantedKey @borrow wantedValue index count =
    if index >= count then false
    else let candidate = get candidates index in
    case candidate of (candidateKey, candidateValue) ->
        if keyEquals wantedKey candidateKey then
            valueEquals wantedValue candidateValue
        else dictEntryPresentAt keyEquals valueEquals candidates wantedKey wantedValue (index + 1) count
    end
GENFN_END
GENFN_BEGIN yona_Prelude__flip flip
flip f a b = f b a
GENFN_END
GENFN_BEGIN yona_Prelude__foldSeqLeft foldSeqLeft
foldSeqLeft : (acc -> element -> acc) -> acc -> Seq element -> acc
foldSeqLeft folder accumulator values =
    case values of
        [head|tail] -> foldSeqLeft folder (folder accumulator head) tail
        [] -> accumulator
    end
GENFN_END
GENFN_BEGIN yona_Prelude__foldSeqRight foldSeqRight
foldSeqRight : (element -> acc -> acc) -> acc -> Seq element -> acc
foldSeqRight folder accumulator values =
    case values of
        [head|tail] -> folder head (foldSeqRight folder accumulator tail)
        [] -> accumulator
    end
GENFN_END
GENFN_BEGIN yona_Prelude__identity identity
identity x = x
GENFN_END
GENFN_BEGIN yona_Prelude__insertDictEntry insertDictEntry
insertDictEntry dictionary entry =
    import put from Std\Dict in
    case entry of (key, value) -> put dictionary key value end
GENFN_END
GENFN_CTOR yona_Prelude__ordering Equal Ordering 1 0 3 0
GENFN_CTOR yona_Prelude__ordering Greater Ordering 2 0 3 0
GENFN_CTOR yona_Prelude__ordering Less Ordering 0 0 3 0
GENFN_BEGIN yona_Prelude__ordering ordering
ordering value = if value < 0 then Less else if value > 0 then Greater else Equal
GENFN_END
GENFN_BEGIN yona_Prelude__seqAllPresentAt seqAllPresentAt
seqAllPresentAt : (element -> element -> Bool) -> Seq element -> Seq element -> Int -> Int -> Int -> Bool
seqAllPresentAt equals @borrow values @borrow candidates index valueCount candidateCount =
    if index >= valueCount then true
    else if seqContainsEqAt equals candidates (get values index) 0 candidateCount then
        seqAllPresentAt equals values candidates (index + 1) valueCount candidateCount
    else false
GENFN_END
GENFN_BEGIN yona_Prelude__seqContainsEqAt seqContainsEqAt
seqContainsEqAt : (element -> element -> Bool) -> Seq element -> element -> Int -> Int -> Bool
seqContainsEqAt equals @borrow candidates needle index count =
    if index >= count then false
    else if equals needle (get candidates index) then true
    else seqContainsEqAt equals candidates needle (index + 1) count
GENFN_END
GENFN_BEGIN yona_Prelude__seqEqAt seqEqAt
seqEqAt : (element -> element -> Bool) -> Seq element -> Seq element -> Int -> Int -> Bool
seqEqAt equals @borrow left @borrow right index count =
    if index >= count then true
    else if equals (get left index) (get right index) then
        seqEqAt equals left right (index + 1) count
    else false
GENFN_END
GENFN_BEGIN yona_Prelude__seqEqBy seqEqBy
seqEqBy : (element -> element -> Bool) -> Seq element -> Seq element -> Bool
seqEqBy equals @borrow left @borrow right =
    let leftLength = length left, rightLength = length right in
    if leftLength == rightLength then seqEqAt equals left right 0 leftLength
    else false
GENFN_END
