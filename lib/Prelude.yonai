    Less -> case _b of
        Less -> Equal
        Equal -> Less
        Greater -> Less
    end
    Equal -> case _b of
        Less -> Greater
        Equal -> Equal
        Greater -> Less
    end
    Greater -> case _b of
        Less -> Greater
        Equal -> Greater
        Greater -> Equal
    end
end
GENFN_END
