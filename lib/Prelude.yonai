GENFN_CTOR Ord_FileMode__compare Write FileMode 1 0 4 0
GENFN_BEGIN Ord_FileMode__compare compare
compare @borrow _a @borrow _b = case _a of
    Read -> case _b of
        Read -> Equal
        Write -> Less
        ReadWrite -> Less
        Append -> Less
    end
    Write -> case _b of
        Read -> Greater
        Write -> Equal
        ReadWrite -> Less
        Append -> Less
    end
    ReadWrite -> case _b of
        Read -> Greater
        Write -> Greater
        ReadWrite -> Equal
        Append -> Less
    end
    Append -> case _b of
        Read -> Greater
        Write -> Greater
        ReadWrite -> Greater
        Append -> Equal
    end
end
GENFN_END
