GENFN_BEGIN Eq_Dict_eq eq
eq : Dict key value -> Dict key value -> Bool
    eq left right =
        import entries, size as dictSize from Std\Dict,
               toSeq from Std\Iterator in
        let leftEntries = toSeq (entries left),
            rightEntries = toSeq (entries right)
        in dictSize left == dictSize right &&
           dictEntriesAllPresentAt (\first second -> eq first second) (\first second -> eq first second) leftEntries rightEntries 0 (primitiveSizeSeq leftEntries) (primitiveSizeSeq rightEntries)
GENFN_END
