GENFN_CTOR Ord_Tuple__compare Less Ordering 0 0 3 0
GENFN_BEGIN Ord_Tuple__compare compare
compare : (left, right) -> (left, right) -> Ordering
    compare (leftFirst, leftSecond) (rightFirst, rightSecond) =
        case compare leftFirst rightFirst of
            Less -> Less
            Greater -> Greater
            Equal -> compare leftSecond rightSecond
        end
GENFN_END
