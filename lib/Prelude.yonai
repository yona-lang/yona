compare @borrow _a @borrow _b = case _a of
    InvalidSyntax _x0 -> case _b of
        InvalidSyntax _y0 -> case compare _x0 _y0 of
            Less -> Less
            Greater -> Greater
            Equal -> Equal
        end
        ParsedValueOutOfRange _ignored0 -> Less
    end
    ParsedValueOutOfRange _x0 -> case _b of
        InvalidSyntax _ignored0 -> Greater
        ParsedValueOutOfRange _y0 -> case compare _x0 _y0 of
            Less -> Less
            Greater -> Greater
            Equal -> Equal
        end
