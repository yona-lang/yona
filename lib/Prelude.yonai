    compare left right =
        import elements from Std\Set, sortBy from Std\List in
        let compareInt first second = case compare first second of
                Less -> -1
                Equal -> 0
                Greater -> 1
            end,
            sortedLeft = sortBy compareInt (elements left),
            sortedRight = sortBy compareInt (elements right)
        in compare sortedLeft sortedRight
