GENFN_CTOR Semigroup_Dict__combine Iterator Iterator 0 1 1 1 recursive field:FUNCTION:ADT:Option a shape:Fn(ADT(Option a)) contract:F(N(%28%29);N(Option,N(a)))
GENFN_BEGIN Semigroup_Dict__combine combine
combine : Dict key value -> Dict key value -> Dict key value
    combine left right =
        import entries from Std\Dict, foldLeft as foldIterator from Std\Iterator in
        foldIterator (entries right) insertDictEntry left
GENFN_END
GENFN_BEGIN Semigroup_Seq__combine combine
combine : Seq element -> Seq element -> Seq element
    combine left right = left ++ right
GENFN_END
GENFN_BEGIN Semigroup_Set__combine combine
combine : Set element -> Set element -> Set element
    combine left right = import union from Std\Set in union left right
GENFN_END
GENFN_BEGIN Semigroup_String__combine combine
combine : String -> String -> String
    combine left right = left ++ right
GENFN_END
