GENFN_CTOR Show_Dict_show Iterator Iterator 0 1 1 1 recursive fields _0:FUNCTION(UNIT,ADT(Option,VAR(a)))
GENFN_CTOR Show_Dict_show Less Ordering 0 0 3 0
GENFN_CTOR Show_Dict_show Equal Ordering 1 0 3 0
GENFN_CTOR Show_Dict_show Greater Ordering 2 0 3 0
GENFN_BEGIN Show_Dict_show show
show : Dict key value -> String
    show dictionary =
        import entries from Std\Dict, toSeq from Std\Iterator,
               sortBy from Std\List in
        let compareEntry first second = case first of
                (firstKey, _) -> case second of
                    (secondKey, _) -> case compare firstKey secondKey of
                        Less -> -1
                        Equal -> 0
                        Greater -> 1
                    end
                end
            end,
            render rest = case rest of
                [(key, value)|tail] -> case tail of
                    [] -> show key ++ ": " ++ show value
                    _ -> show key ++ ": " ++ show value ++ ", " ++ render tail
                end
                [] -> ""
            end
        in "{{" ++ render (sortBy compareEntry (toSeq (entries dictionary))) ++ "}}"
GENFN_END
GENFN_CTOR Show_FileMode_show Read FileMode 0 0 4 0
GENFN_CTOR Show_FileMode_show Write FileMode 1 0 4 0
GENFN_CTOR Show_FileMode_show ReadWrite FileMode 2 0 4 0
GENFN_CTOR Show_FileMode_show Append FileMode 3 0 4 0
GENFN_BEGIN Show_FileMode_show show
show @borrow x = case x of
    Read -> "Read"
    Write -> "Write"
    ReadWrite -> "ReadWrite"
    Append -> "Append"
end
GENFN_END
