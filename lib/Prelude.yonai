GENFN_BEGIN Show_Seq__show show
show : Seq element -> String
    show values =
        let render rest = case rest of
            [head|tail] -> case tail of
                [] -> show head
                _ -> show head ++ ", " ++ render tail
            end
            [] -> ""
        end
        in "[" ++ render values ++ "]"
GENFN_END
GENFN_CTOR Show_Set__show Equal Ordering 1 0 3 0
GENFN_CTOR Show_Set__show Greater Ordering 2 0 3 0
GENFN_CTOR Show_Set__show Less Ordering 0 0 3 0
GENFN_BEGIN Show_Set__show show
show : Set element -> String
    show values =
        import elements from Std\Set, sortBy from Std\List in
        let compareInt first second = case compare first second of
                Less -> -1
                Equal -> 0
                Greater -> 1
            end,
            render rest = case rest of
                [head|tail] -> case tail of
                    [] -> show head
                    _ -> show head ++ ", " ++ render tail
                end
                [] -> ""
            end
        in "{{" ++ render (sortBy compareInt (elements values)) ++ "}}"
GENFN_END
