    Ok _x0 -> case _b of
        Ok _y0 -> case compare _x0 _y0 of
            Less -> Less
            Greater -> Greater
            Equal -> Equal
        end
        Err _ignored0 -> Less
    end
    Err _x0 -> case _b of
        Ok _ignored0 -> Greater
        Err _y0 -> case compare _x0 _y0 of
            Less -> Less
            Greater -> Greater
            Equal -> Equal
        end
    end
end
GENFN_END
GENFN_CTOR Ord_Seq__compare Equal Ordering 1 0 3 0
GENFN_CTOR Ord_Seq__compare Greater Ordering 2 0 3 0
GENFN_CTOR Ord_Seq__compare Less Ordering 0 0 3 0
GENFN_BEGIN Ord_Seq__compare compare
compare : Seq element -> Seq element -> Ordering
    compare left right =
        let leftLength = length left,
            rightLength = length right,
            commonLength = if leftLength < rightLength then leftLength else rightLength,
            loop index = if index >= commonLength then
                    if leftLength < rightLength then Less
                    else if leftLength > rightLength then Greater else Equal
                else if get left index < get right index then Less
                else if get left index > get right index then Greater
                else loop (index + 1)
        in loop 0
GENFN_END
GENFN_CTOR Ord_Set__compare Equal Ordering 1 0 3 0
GENFN_CTOR Ord_Set__compare Greater Ordering 2 0 3 0
GENFN_CTOR Ord_Set__compare Less Ordering 0 0 3 0
GENFN_BEGIN Ord_Set__compare compare
compare : Set element -> Set element -> Ordering
    compare left right =
        import elements from Std\Set, sortBy from Std\List in
        let compareInt first second = case compare first second of
                Less -> -1
                Equal -> 0
                Greater -> 1
            end,
            sortedLeft = sortBy compareInt (elements left),
            sortedRight = sortBy compareInt (elements right)
        in compare sortedLeft sortedRight
GENFN_END
