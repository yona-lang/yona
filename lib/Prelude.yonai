GENFN_CTOR Show_Result_show Ok Result 0 1 2 1 fields _0:VAR(a)
GENFN_CTOR Show_Result_show Err Result 1 1 2 1 fields _0:VAR(e)
GENFN_BEGIN Show_Result_show show
show @borrow x = case x of
    Ok _f0 -> "Ok(" ++ show _f0 ++ ")"
    Err _f0 -> "Err(" ++ show _f0 ++ ")"
end
GENFN_END
GENFN_BEGIN Show_Seq_show show
show : Seq element -> String
    show values =
        let render rest = case rest of
            [head|tail] -> case tail of
                [] -> show head
                _ -> show head ++ ", " ++ render tail
            end
            [] -> ""
        end
        in "[" ++ render values ++ "]"
GENFN_END
GENFN_CTOR Show_Set_show Less Ordering 0 0 3 0
GENFN_CTOR Show_Set_show Equal Ordering 1 0 3 0
GENFN_CTOR Show_Set_show Greater Ordering 2 0 3 0
GENFN_BEGIN Show_Set_show show
show : Set element -> String
    show values =
        import elements from Std\Set, sortBy from Std\List in
        let compareInt first second = case compare first second of
                Less -> -1
                Equal -> 0
                Greater -> 1
            end,
            render rest = case rest of
                [head|tail] -> case tail of
                    [] -> show head
                    _ -> show head ++ ", " ++ render tail
                end
                [] -> ""
            end
        in "{{" ++ render (sortBy compareInt (elements values)) ++ "}}"
GENFN_END
GENFN_DEP Show_String_show primitiveShowString NATIVE YonaRuntimeShowStringShow FN 1 STRING -> STRING
GENFN_BEGIN Show_String_show show
show : String -> String
    show value = primitiveShowString value
