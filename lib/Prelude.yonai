GENFN_BEGIN Show_Symbol_show show
show : Symbol -> String
    show value = primitiveShowSymbol value
GENFN_END
GENFN_BEGIN Show_Tuple_show show
show : (left, right) -> String
    show (first, second) = "(" ++ show first ++ ", " ++ show second ++ ")"
GENFN_END
