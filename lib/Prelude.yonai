    show value = primitiveShowInt value
GENFN_END
GENFN_CTOR Show_Option_show Some Option 0 1 2 1 fields _0:VAR(a)
GENFN_CTOR Show_Option_show None Option 1 0 2 1
GENFN_BEGIN Show_Option_show show
show @borrow x = case x of
    Some _f0 -> "Some(" ++ show _f0 ++ ")"
    None -> "None"
end
GENFN_END
GENFN_CTOR Show_ParseError_show InvalidSyntax ParseError 0 1 2 1 fields _0:STRING
GENFN_CTOR Show_ParseError_show ParsedValueOutOfRange ParseError 1 1 2 1 fields _0:STRING
GENFN_BEGIN Show_ParseError_show show
show @borrow x = case x of
    InvalidSyntax _f0 -> "InvalidSyntax(" ++ show _f0 ++ ")"
    ParsedValueOutOfRange _f0 -> "ParsedValueOutOfRange(" ++ show _f0 ++ ")"
end
