GENFN_BEGIN Ord_Option__compare compare
compare @borrow _a @borrow _b = case _a of
    Some _x0 -> case _b of
        Some _y0 -> case compare _x0 _y0 of
            Less -> Less
            Greater -> Greater
            Equal -> Equal
        end
        None -> Less
    end
    None -> case _b of
        Some _ignored0 -> Greater
        None -> Equal
    end
end
