GENFN_CTOR Ord_ConvertError__compare ConversionOutOfRange ConvertError 1 1 2 1 field:STRING shape:STRING contract:N(String)
GENFN_CTOR Ord_ConvertError__compare Equal Ordering 1 0 3 0
GENFN_CTOR Ord_ConvertError__compare Greater Ordering 2 0 3 0
GENFN_CTOR Ord_ConvertError__compare InvalidConversion ConvertError 0 1 2 1 field:STRING shape:STRING contract:N(String)
GENFN_CTOR Ord_ConvertError__compare Less Ordering 0 0 3 0
GENFN_BEGIN Ord_ConvertError__compare compare
compare @borrow _a @borrow _b = case _a of
    InvalidConversion _x0 -> case _b of
        InvalidConversion _y0 -> case compare _x0 _y0 of
            Less -> Less
            Greater -> Greater
            Equal -> Equal
        end
        ConversionOutOfRange _ignored0 -> Less
    end
    ConversionOutOfRange _x0 -> case _b of
        InvalidConversion _ignored0 -> Greater
        ConversionOutOfRange _y0 -> case compare _x0 _y0 of
            Less -> Less
            Greater -> Greater
            Equal -> Equal
        end
    end
end
GENFN_END
GENFN_CTOR Ord_Dict__compare Equal Ordering 1 0 3 0
GENFN_CTOR Ord_Dict__compare Greater Ordering 2 0 3 0
GENFN_CTOR Ord_Dict__compare Iterator Iterator 0 1 1 1 recursive field:FUNCTION:ADT:Option a shape:Fn(ADT(Option a)) contract:F(N(%28%29);N(Option,N(a)))
GENFN_CTOR Ord_Dict__compare Less Ordering 0 0 3 0
GENFN_BEGIN Ord_Dict__compare compare
compare : Dict key value -> Dict key value -> Ordering
    compare left right =
        import entries from Std\Dict, toSeq from Std\Iterator,
               sortBy from Std\List in
        let compareEntry first second = case first of
                (firstKey, _) -> case second of
                    (secondKey, _) -> case compare firstKey secondKey of
                        Less -> -1
                        Equal -> 0
                        Greater -> 1
                    end
                end
            end,
            sortedLeft = sortBy compareEntry (toSeq (entries left)),
            sortedRight = sortBy compareEntry (toSeq (entries right))
        in compare sortedLeft sortedRight
GENFN_END
