GENFN_CTOR Show_Dict__show Equal Ordering 1 0 3 0
GENFN_CTOR Show_Dict__show Greater Ordering 2 0 3 0
GENFN_CTOR Show_Dict__show Iterator Iterator 0 1 1 1 recursive field:FUNCTION:ADT:Option a shape:Fn(ADT(Option a)) contract:F(N(%28%29);N(Option,N(a)))
GENFN_CTOR Show_Dict__show Less Ordering 0 0 3 0
GENFN_BEGIN Show_Dict__show show
show : Dict key value -> String
    show dictionary =
        import entries from Std\Dict, toSeq from Std\Iterator,
               sortBy from Std\List in
        let compareEntry first second = case first of
                (firstKey, _) -> case second of
                    (secondKey, _) -> case compare firstKey secondKey of
                        Less -> -1
                        Equal -> 0
                        Greater -> 1
                    end
                end
            end,
            render rest = case rest of
                [(key, value)|tail] -> case tail of
                    [] -> show key ++ ": " ++ show value
                    _ -> show key ++ ": " ++ show value ++ ", " ++ render tail
                end
                [] -> ""
            end
        in "{{" ++ render (sortBy compareEntry (toSeq (entries dictionary))) ++ "}}"
GENFN_END
