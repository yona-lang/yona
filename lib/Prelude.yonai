MODULE Prelude
ADT ConvertError 2 1
  CTOR InvalidConversion 0 1 fields _0:STRING
  CTOR ConversionOutOfRange 1 1 fields _0:STRING
ADT FileHandle 1 1
  CTOR FileHandle 0 1 fields _0:INT
ADT FileMode 4 0
  CTOR Read 0 0
  CTOR Write 1 0
  CTOR ReadWrite 2 0
  CTOR Append 3 0
ADT Iterator 1 1 recursive params a
  CTOR Iterator 0 1 fields _0:FUNCTION(UNIT,ADT(Option,VAR(a)))
ADT Linear 1 1 params a
  CTOR Linear 0 1 fields _0:VAR(a)
ADT Option 2 1 params a
  CTOR Some 0 1 fields _0:VAR(a)
  CTOR None 1 0
ADT Ordering 3 0
  CTOR Less 0 0
  CTOR Equal 1 0
  CTOR Greater 2 0
ADT ParseError 2 1
  CTOR InvalidSyntax 0 1 fields _0:STRING
  CTOR ParsedValueOutOfRange 1 1 fields _0:STRING
ADT Result 2 1 params a e
  CTOR Ok 0 1 fields _0:VAR(a)
  CTOR Err 1 1 fields _0:VAR(e)
ADT Type 18 1
  CTOR TypeInt 0 0
  CTOR TypeFloat 1 0
  CTOR TypeBool 2 0
  CTOR TypeString 3 0
  CTOR TypeSymbol 4 0
  CTOR TypeUnit 5 0
  CTOR TypeSeq 6 0
  CTOR TypeSet 7 0
  CTOR TypeDict 8 0
  CTOR TypeTuple 9 0
  CTOR TypeFunction 10 0
  CTOR TypePromise 11 0
  CTOR TypeByteArray 12 0
  CTOR TypeIntArray 13 0
  CTOR TypeFloatArray 14 0
  CTOR TypeAdt 15 1 fields _0:STRING
  CTOR TypeSum 16 0
  CTOR TypeRecord 17 0
ADT Whence 3 0
  CTOR SeekSet 0 0
  CTOR SeekCur 1 0
  CTOR SeekEnd 2 0
TRAIT Array array element 2
  METHOD get FUNCTION(VAR(array),FUNCTION(INT,VAR(element)))
  METHOD length FUNCTION(VAR(array),INT)
TRAIT Closeable a 1
  METHOD close FUNCTION(VAR(a),UNIT)
TRAIT Eq a 1
  METHOD eq FUNCTION(VAR(a),FUNCTION(VAR(a),BOOL))
TRAIT Foldable collection element 2
  METHOD foldLeft FUNCTION(VAR(collection),FUNCTION(FUNCTION(VAR(acc),FUNCTION(VAR(element),VAR(acc))),FUNCTION(VAR(acc),VAR(acc))))
  METHOD foldRight FUNCTION(VAR(collection),FUNCTION(FUNCTION(VAR(element),FUNCTION(VAR(acc),VAR(acc))),FUNCTION(VAR(acc),VAR(acc))))
TRAIT From target source 1
  METHOD convert FUNCTION(VAR(target),FUNCTION(VAR(source),VAR(target)))
TRAIT Hash a 1
  SUPER Eq a
  METHOD hash FUNCTION(VAR(a),INT)
TRAIT Iterable collection element 1
  METHOD toIterator FUNCTION(VAR(collection),ADT(Iterator,VAR(element)))
TRAIT Monoid a 1
  SUPER Semigroup a
  METHOD emptyLike FUNCTION(VAR(a),VAR(a))
TRAIT Ord a 1
  SUPER Eq a
  METHOD compare FUNCTION(VAR(a),FUNCTION(VAR(a),ADT(Ordering)))
TRAIT Parse target 1
  METHOD parse FUNCTION(VAR(target),FUNCTION(STRING,ADT(Result,VAR(target),ADT(ParseError))))
TRAIT Semigroup a 1
  METHOD combine FUNCTION(VAR(a),FUNCTION(VAR(a),VAR(a)))
TRAIT Send a 0
TRAIT Shareable a 0
  SUPER Send a
TRAIT Show a 1
  METHOD show FUNCTION(VAR(a),STRING)
TRAIT Sized a 1
  METHOD size FUNCTION(VAR(a),INT)
TRAIT TryFrom target source 1
  METHOD tryConvert FUNCTION(VAR(target),FUNCTION(VAR(source),ADT(Result,VAR(target),ADT(ConvertError))))
