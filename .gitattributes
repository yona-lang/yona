# Canonical repository text format. The quality check rejects CRLF and BOM in
# tracked text, regardless of the contributor's platform.
* text=auto eol=lf

*.bat text eol=lf
*.cmd text eol=lf
*.ps1 text eol=lf
*.psd1 text eol=lf
*.psm1 text eol=lf
*.sh text eol=lf
*.yona text eol=lf
*.yonai text eol=lf

# Generated and binary fixtures must never pass through line-ending conversion.
*.a binary
*.bin binary
*.bmp binary
*.dll binary
*.dylib binary
*.exe binary
*.gif binary
*.ico binary
*.jpg binary
*.jpeg binary
*.lib binary
*.o binary
*.obj binary
*.pdf binary
*.png binary
*.so binary
*.spv binary
*.vsix binary
*.webp binary
*.zip binary

*.yonai linguist-generated=true
**/Generated/** linguist-generated=true
editors/vscode/package-lock.json linguist-generated=true
site/pnpm-lock.yaml linguist-generated=true
