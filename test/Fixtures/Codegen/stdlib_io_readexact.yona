import writeFile, openFile, closeFileHandle, readExactBytes, Read from Std\File,
       readExact, stdinFd from Std\Io,
       isOk from Std\Result in
do
    wrote = writeFile "/tmp/yona_readexact_prereq.txt" "frame!"
    bytes = case openFile "/tmp/yona_readexact_prereq.txt" Read of
        Linear h -> do
            contents = readExactBytes h 6
            closeFileHandle h
            contents
        end
    end
    emptyOk = isOk (readExact stdinFd 0)
    if emptyOk then bytes else "not-ok"
end
