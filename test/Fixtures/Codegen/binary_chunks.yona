import openFile, writeBytes, readChunks, closeFileHandle from Std\File, fromString, length from Std\ByteArray in
let foldl fn acc seq = case seq of [] -> acc; [h|t] -> foldl fn (fn acc h) t end in
case openFile "/tmp/yona_binary_chunks.bin" Write of
    Linear wh -> do
        writeBytes wh (fromString "hello world, this is a test of chunked reading")
        closeFileHandle wh
        case openFile "/tmp/yona_binary_chunks.bin" Read of
            Linear rh -> do
                iter = readChunks rh 10
                total = foldl (\acc chunk -> acc + length chunk) 0 [chunk for chunk = iter]
                closeFileHandle rh
                total
            end
        end
    end
end
