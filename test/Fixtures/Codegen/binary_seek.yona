import openFile, readBytes, writeBytes, seek, closeFileHandle from Std\File, fromString, get from Std\ByteArray in
case openFile "/tmp/yona_binary_seek.bin" Write of
    Linear wh -> do
        writeBytes wh (fromString "abcdefghij")
        closeFileHandle wh
        case openFile "/tmp/yona_binary_seek.bin" Read of
            Linear rh -> do
                seek rh 5 SeekSet
                data = readBytes rh 3
                closeFileHandle rh
                get data 0
            end
        end
    end
end
