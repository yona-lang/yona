import allocPinnedFloats, pinnedSet, pinnedGet, closePinnedFloats, mapFloatPinnedGpu, Scale, pinnedBackend from Std\Gpu in
let p = allocPinnedFloats 2 in
let _ = pinnedSet p 0 1.5 in
let _ = pinnedSet p 1 2.5 in
let _ = mapFloatPinnedGpu (Scale 2.0) p in
let s = pinnedGet p 0 + pinnedGet p 1 in
let be = pinnedBackend p in
let _ = closePinnedFloats p in
## Backend must be one of the two supported names; numeric result is always 8.0.
case be of
    "vulkan-mapped" -> s
    "host-malloc" -> s
    _ -> 0.0
end
