let tupleMatch = case (2.5, "two", false, 66b, 'B') of
        (1.5, "two", false, 66b, 'B') -> false
        (2.5, "two", false, 66b, 'B') -> true
        _ -> false
    end,
    nestedTupleMatch = case (("two", 2.5), false) of
        (("one", 2.5), false) -> false
        (("two", 2.5), false) -> true
        _ -> false
    end,
    constructorMatch = case Some "two" of
        Some "one" -> false
        Some "two" -> true
        None -> false
    end,
    headTailMatch = case ["two", "rest"] of
        ["one" | _] -> false
        ["two" | _] -> true
        _ -> false
    end,
    tupleHeadMatch = case [(1, "two")] of
        [(1, "wrong") | _] -> false
        _ -> true
    end,
    nestedTupleHeadMatch = case [((1, "two"), 3)] of
        [((1, "wrong"), 3) | _] -> false
        _ -> true
    end,
    constructorHeadMatch = case [(Some "two", 3)] of
        [(Some "wrong", 3) | _] -> false
        _ -> true
    end,
    recordHeadMatch = import pass, testCase from Std\Test in
        case [testCase "two" (\() -> pass "ok")] of
            [TestCase { name = "wrong" } | _] -> false
            _ -> true
        end
in (tupleMatch, nestedTupleMatch, constructorMatch, headTailMatch,
    tupleHeadMatch, nestedTupleHeadMatch, constructorHeadMatch, recordHeadMatch)
