import openFile, readBytes, writeBytes, closeFileHandle from Std\File, fromString, length from Std\ByteArray in
case openFile "/tmp/yona_binary_test.bin" Write of
    Linear wh -> do
        writeBytes wh (fromString "hello binary")
        closeFileHandle wh
        case openFile "/tmp/yona_binary_test.bin" Read of
            Linear rh -> do
                data = readBytes rh 12
                closeFileHandle rh
                length data
            end
        end
    end
end
