import backendName, vulkanStatus, hasGpu, hasSimd, available, apiVersion, physicalDeviceCount from Std\GPU,
       length from Std\String,
       testCase, check, run, render from Std\Test
in
let cases = [
    testCase "GPU backend reports a name" (\_ ->
        check "backend name" (length backendName > 0 && length vulkanStatus > 0)),
    testCase "GPU availability probe is stable" (\_ ->
        check "available" (available () == available ())),
    testCase "GPU numeric probes are nonnegative" (\_ ->
        check "probe counts" (apiVersion () >= 0 && physicalDeviceCount () >= 0))
] in render (run cases)
