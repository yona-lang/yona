#pragma once
// Generated by CMake — absolute path to the repository root (same as CMAKE_SOURCE_DIR).
#define YONA_SOURCE_DIR "@CMAKE_SOURCE_DIR@"
#define YONA_BINARY_DIR "@CMAKE_BINARY_DIR@"
#define YONA_BUILD_INCLUDE_DIR "@CMAKE_CURRENT_BINARY_DIR@/include"
#define YONA_TEST_PRELUDE_OBJECT "@YONA_TEST_PRELUDE_OBJECT@"
#define YONA_TEST_PCRE2_INCLUDE_DIR "@YONA_TEST_PCRE2_INCLUDE_DIR@"
#define YONA_TEST_PCRE2_ARCHIVE "@YONA_TEST_PCRE2_ARCHIVE@"
#define YONA_TEST_PCRE2_CFLAGS "@YONA_TEST_PCRE2_CFLAGS@"

/* MSVC/UCRT tests use _popen/_pclose; map POSIX names for portable test sources. */
#if defined(_WIN32)
#include <stdio.h>
#ifndef popen
#define popen _popen
#endif
#ifndef pclose
#define pclose _pclose
#endif
#endif
