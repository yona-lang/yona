# yls-yona — Yona-written LSP transport (stdio JSON-RPC)
#
# Built by cmake/YonaTools.cmake as `yls-yona` next to yonac.
# C++ `yls` remains the installed editor default. This binary speaks
# initialize / initialized / shutdown / exit / textDocument/didOpen.
# Unknown methods return JSON null (same as C++ yls). Hover, definition,
# and other compiler queries still need C++ yls: `YonaTypedCoreAnalyze` lives
# in yona_lib and is not linked into yonac-built tools.
#
# Field reads use `Std\Json.get` / `asString` / `asInt` on the parsed ADT.
#
# 0-arg let bindings are eager CAFs, so usage takes a dummy `_`.

import getArgs, exit, yonaVersion from Std\Process,
       stdinFd, stdoutFd, writeBytes, readExact, eprintln from Std\Io,
       parse, stringify, get as jsonGet, asString, asInt, JsonNull, JsonInt, JsonString, JsonArray, JsonObject from Std\Json,
       offsetToLine, offsetToCharacter from Std\Utf16,
       length, drop, take, indexOf, toLowerCase, trim, charAt, endsWith from Std\String,
       intToString from Std\Types
in
let
  usage _ =
    do
      eprintln "yls-yona — Yona language server (transport slice)"
      eprintln "Usage: yls-yona [--stdio]"
      exit 0
    end,

  takeUntilCr s =
    if s == "" then s
    else if charAt s 0 == 13 || charAt s 0 == 10 then ""
    else (take 1 s) ++ takeUntilCr (drop 1 s),

  parseLen acc s =
    if s == "" then acc
    else if charAt s 0 >= 48 && charAt s 0 <= 57 then
      parseLen (acc * 10 + (charAt s 0 - 48)) (drop 1 s)
    else acc,

  contentLength headers =
    let lower = toLowerCase headers,
        idx = indexOf "content-length:" lower
    in
      if idx < 0 then -1
      else parseLen 0 (trim (takeUntilCr (drop (idx + 15) headers))),

  readHeaders acc =
    case readExact stdinFd 1 of
      Ok b ->
        let next = acc ++ b in
        if endsWith "\r\n\r\n" next then Ok next
        else readHeaders next
      Err e -> Err e
    end,

  fieldString j key =
    case jsonGet j key of
      Some v -> asString v
      None -> None
    end,

  fieldInt j key =
    case jsonGet j key of
      Some v -> asInt v
      None -> None
    end,

  methodOf j =
    case fieldString j "method" of
      Some m -> m
      None -> ""
    end,

  rangeJson sl sc el ec =
    JsonObject [("start", JsonObject [("line", JsonInt sl), ("character", JsonInt sc)]), ("end", JsonObject [("line", JsonInt el), ("character", JsonInt ec)])],

  docRange text =
    let n = length text in rangeJson (offsetToLine text 0) (offsetToCharacter text 0) (offsetToLine text n) (offsetToCharacter text n),

  dropUri docs uri =
    case docs of
      [] -> []
      [(u, t) | rest] -> if u == uri then dropUri rest uri else (u, t) :: dropUri rest uri
    end,

  storeDoc docs uri text =
    let rng = docRange text in (uri, text) :: dropUri docs uri,

  didOpenFields j =
    case jsonGet j "params" of
      Some params ->
        case jsonGet params "textDocument" of
          Some doc ->
            case fieldString doc "uri" of
              Some uri ->
                case fieldString doc "text" of
                  Some text -> Some (uri, text)
                  None -> None
                end
              None -> None
            end
          None -> None
        end
      None -> None
    end,

  initResult =
    JsonObject [("capabilities", JsonObject [("textDocumentSync", JsonInt 1)]), ("serverInfo", JsonObject [("name", JsonString "yls-yona"), ("version", JsonString yonaVersion)])],

  rpcResult id value =
    JsonObject [("jsonrpc", JsonString "2.0"), ("id", JsonInt id), ("result", value)],

  diagNotify uri =
    JsonObject [("jsonrpc", JsonString "2.0"), ("method", JsonString "textDocument/publishDiagnostics"), ("params", JsonObject [("uri", JsonString uri), ("diagnostics", JsonArray [])])],

  writeFrame obj =
    let body = stringify obj,
        n = length body
    in writeBytes stdoutFd ("Content-Length: " ++ intToString n ++ "\r\n\r\n" ++ body),

  reply idOpt value =
    case idOpt of
      Some id -> writeFrame (rpcResult id value)
      None -> ()
    end,

  readMessage _ =
    case readHeaders "" of
      Err _ -> None
      Ok headers ->
        let n = contentLength headers in
        if n < 0 then None
        else
          case readExact stdinFd n of
            Err _ -> None
            Ok body ->
              case parse body of
                Ok j -> Some j
                Err _ -> readMessage 0
              end
          end
    end,

  serve docs shutdown =
    case readMessage 0 of
      None -> if shutdown != 0 then exit 0 else exit 1
      Some msg ->
        let method = methodOf msg,
            idOpt = fieldInt msg "id"
        in
          if method == "exit" then
            if shutdown != 0 then exit 0 else exit 1
          else if method == "shutdown" then
            do
              reply idOpt JsonNull
              serve docs 1
            end
          else if method == "initialized" then
            serve docs shutdown
          else if method == "initialize" then
            do
              reply idOpt initResult
              serve docs shutdown
            end
          else if method == "textDocument/didOpen" then
            case didOpenFields msg of
              Some pair ->
                case pair of
                  (uri, text) ->
                    do
                      writeFrame (diagNotify uri)
                      serve (storeDoc docs uri text) shutdown
                    end
                end
              None -> serve docs shutdown
            end
          else
            do
              reply idOpt JsonNull
              serve docs shutdown
            end
    end,

  dispatch rest =
    case rest of
      [] -> serve [] 0
      [flag | more] ->
        if flag == "--help" || flag == "-h" then usage 0
        else if flag == "--stdio" then dispatch more
        else if flag == "-I" then
          case more of
            [] -> serve [] 0
            [_ | rest2] -> dispatch rest2
          end
        else dispatch more
    end
in
  case getArgs of
    [] -> dispatch []
    [_ | rest] -> dispatch rest
  end
