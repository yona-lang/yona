#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer Data {
    int elems[];
};

layout(push_constant) uniform Push {
    int delta;
    uint elem_count;
};

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= elem_count) return;
    elems[idx] += delta;
}
