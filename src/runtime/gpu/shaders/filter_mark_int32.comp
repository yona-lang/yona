#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer InBuf {
    int elems[];
};

layout(set = 0, binding = 1) buffer FlagBuf {
    int flags[];
};

layout(push_constant) uniform Push {
    int threshold;
    uint elem_count;
};

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= elem_count) return;
    int v = elems[gid];
    flags[int(gid)] = (v > threshold) ? 1 : 0;
}
