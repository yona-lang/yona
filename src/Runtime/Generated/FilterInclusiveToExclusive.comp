#version 450
#extension GL_ARB_gpu_shader_int64 : require

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer IncBuf {
    int64_t inclusive[];
};

layout(set = 0, binding = 1) buffer FlagBuf {
    int flags[];
};

layout(set = 0, binding = 2) buffer PrefixBuf {
    int64_t prefix[];
};

layout(push_constant) uniform Push {
    uint elem_count;
};

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= elem_count) return;
    int64_t incv = inclusive[gid];
    int fi = flags[int(gid)];
    prefix[gid] = incv - int64_t(fi);
}
